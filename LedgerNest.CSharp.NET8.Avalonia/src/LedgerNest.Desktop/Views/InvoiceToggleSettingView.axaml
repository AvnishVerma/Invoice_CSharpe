<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.InvoiceToggleSettingView">
  <Border Padding="12" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
    <Grid ColumnDefinitions="24,16,*,16,Auto">
      <TextBlock x:Name="IconText" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="22" Foreground="{DynamicResource AppHeaderBrush}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="16" />
        <TextBlock x:Name="HelpText" FontSize="13" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <ToggleButton x:Name="Toggle" Grid.Column="4" Padding="0" BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
        <Border x:Name="Track" Width="42" Height="26" CornerRadius="18" BorderThickness="2" Padding="3">
          <Ellipse x:Name="Thumb" Width="16" Height="16" />
        </Border>
      </ToggleButton>
    </Grid>
  </Border>
</UserControl>
