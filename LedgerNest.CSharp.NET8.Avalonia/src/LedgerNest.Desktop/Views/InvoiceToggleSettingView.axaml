<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LedgerNest.Desktop.Views" xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="LedgerNest.Desktop.Views.InvoiceToggleSettingView" x:Name="Root">
  <UserControl.Resources>
    <DataTemplate x:Key="CardLayout" x:DataType="local:InvoiceToggleLayoutModel">
      <Border Padding="12" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="24,16,*,16,Auto">
          <TextBlock Text="{Binding Icon}" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="22" Foreground="{DynamicResource PageHeaderBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="16" />
            <TextBlock Text="{Binding Help}" IsVisible="{Binding Help, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" FontSize="13" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <local:FormToggleSwitchView Grid.Column="4" Field="{Binding Field}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CompactLayout" x:DataType="local:InvoiceToggleLayoutModel">
      <Grid ColumnDefinitions="*,16,Auto">
        <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
        <local:FormToggleSwitchView Grid.Column="2" Field="{Binding Field}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LeadingLayout" x:DataType="local:InvoiceToggleLayoutModel">
      <Grid ColumnDefinitions="52,16,*">
        <local:FormToggleSwitchView Field="{Binding Field}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ContentControl#Layout"><Setter Property="ContentTemplate" Value="{StaticResource CardLayout}" /></Style>
    <Style Selector="ContentControl#Layout.compact"><Setter Property="ContentTemplate" Value="{StaticResource CompactLayout}" /></Style>
    <Style Selector="ContentControl#Layout.leading"><Setter Property="ContentTemplate" Value="{StaticResource LeadingLayout}" /></Style>
  </UserControl.Styles>
  <ContentControl x:Name="Layout" Content="{Binding LayoutData, ElementName=Root}" Classes.compact="{Binding Compact, ElementName=Root}" Classes.leading="{Binding Leading, ElementName=Root}" />
</UserControl>
