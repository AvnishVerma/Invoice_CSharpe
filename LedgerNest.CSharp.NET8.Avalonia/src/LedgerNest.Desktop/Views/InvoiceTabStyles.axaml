<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.invoice-tab-card">
    <Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineBrush}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="StackPanel.invoice-tab-content"><Setter Property="Spacing" Value="12"/></Style>
  <Style Selector="StackPanel.invoice-tab-heading"><Setter Property="MinHeight" Value="48"/><Setter Property="Orientation" Value="Horizontal"/><Setter Property="Spacing" Value="10"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style Selector="Border.invoice-tab-icon">
    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/><Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
  </Style>
  <Style Selector="Border.invoice-tab-icon TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="TextBlock.invoice-tab-title"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="ScrollViewer.invoice-tab-scroll">
    <!-- Reserve a scrollbar column instead of drawing an auto-hidden bar over fields. -->
    <Setter Property="AllowAutoHide" Value="False"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
</Styles>
