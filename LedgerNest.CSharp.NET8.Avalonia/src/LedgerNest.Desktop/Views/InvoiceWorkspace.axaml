<UserControl xmlns:icons="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LedgerNest.Desktop.Views" xmlns:vm="using:LedgerNest.Desktop"
             x:Class="LedgerNest.Desktop.Views.InvoiceWorkspace" x:CompileBindings="False">
  <UserControl.Resources>
    <ControlTheme x:Key="InvoiceInformationTabs" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
      <Setter Property="Template"><ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <ScrollViewer x:Name="InvoiceTabHeaderScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="InvoiceInformationTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
        <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border></ControlTemplate></Setter>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/></Style>
      <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource AppSelectedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
      <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    </ControlTheme>

    <DataTemplate x:Key="LeftPane">
      <Grid MinHeight="320">
        <Border Padding="16" CornerRadius="16" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock vm:UiLocalization.Text="Items" FontSize="16" FontWeight="SemiBold" /><Border CornerRadius="8" Background="{DynamicResource AppSurfaceBrush}" Padding="8,1"><TextBlock Text="{Binding ItemCount}" FontSize="11" /></Border></StackPanel>
            <local:InvoiceLineItemsView Grid.Row="2" DataContext="{Binding LineItems}" Margin="0,16" />
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" CornerRadius="12" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="ProductSearch" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search &amp; add a product or service (Ctrl+F)" MinWidth="100" Padding="{DynamicResource TextInputIconPadding}" KeyDown="SearchKeyDown" />
                  <TextBlock Text="{icons:FontAwesomeGlyph search}" Classes="action-icon-glyph" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <Button Grid.Column="1" Classes="action outline" Command="{Binding CustomItemCommand}" Margin="12,0,0,0" ToolTip.Tip="Custom item (Ctrl+M)"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{icons:FontAwesomeGlyph add}" Classes="action-icon-glyph" /><TextBlock Text="{Binding CustomItemCaption}" /></StackPanel></Button>
                </Grid>
                <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}" IsVisible="{Binding ShowSuggestions}" MaxHeight="260">
                  <ListBox.ItemTemplate><DataTemplate><Border Padding="12" MinHeight="64"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontSize="14" Classes.out-of-stock="{Binding IsOutOfStock}" /><TextBlock Text="{Binding Metadata}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="RightPane">
      <Grid RowDefinitions="*,12,Auto">
        <TabControl x:Name="InvoiceDetailTabs" AutomationProperties.Name="Invoice information" SelectedIndex="0" Theme="{StaticResource InvoiceInformationTabs}">
          <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></TabControl.ItemsPanel>
          <TabItem AutomationProperties.Name="Customer">
            <TabItem.Header><TextBlock vm:UiLocalization.Text="Customer" FontSize="13" TextWrapping="NoWrap" TextAlignment="Center"/></TabItem.Header>
            <local:InvoiceCustomerPanelView DataContext="{Binding Customer}"/>
          </TabItem>
          <TabItem AutomationProperties.Name="Invoice Details">
            <TabItem.Header><TextBlock vm:UiLocalization.Text="Invoice Details" FontSize="13" TextWrapping="NoWrap" TextAlignment="Center"/></TabItem.Header>
            <local:InvoiceDocumentDetailsPanelView DataContext="{Binding Details}"/>
          </TabItem>
          <TabItem AutomationProperties.Name="Charges">
            <TabItem.Header><TextBlock vm:UiLocalization.Text="Charges" FontSize="13" TextWrapping="NoWrap" TextAlignment="Center"/></TabItem.Header>
            <local:InvoiceOptionsPanelView DataContext="{Binding Options}" Classes="charges-only"/>
          </TabItem>
          <TabItem AutomationProperties.Name="Adjustments">
            <TabItem.Header><TextBlock vm:UiLocalization.Text="Adjustments" FontSize="13" TextWrapping="NoWrap" TextAlignment="Center"/></TabItem.Header>
            <local:InvoiceOptionsPanelView DataContext="{Binding Options}" Classes="adjustments-only"/>
          </TabItem>
          <TabItem AutomationProperties.Name="Tax Details">
            <TabItem.Header><TextBlock vm:UiLocalization.Text="Tax Details" FontSize="13" TextWrapping="NoWrap" TextAlignment="Center"/></TabItem.Header>
            <local:InvoiceOptionsPanelView DataContext="{Binding Options}" Classes="tax-only"/>
          </TabItem>
        </TabControl>
        <Border x:Name="FooterFrame" Grid.Row="2" Padding="20" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource AppOutlineBrush}" Background="{DynamicResource AppCanvasBrush}">
          <ContentControl x:Name="InvoiceFooterTotals"><local:InvoiceTotalsView DataContext="{Binding TotalsModel}" /></ContentControl>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="WideWorkspace">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="500" /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.65*" MinWidth="320" MaxWidth="500" /></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch" Padding="0,0,4,0"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource LeftPane}" VerticalContentAlignment="Stretch" /></ScrollViewer>
        <GridSplitter Grid.Column="1" Width="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" ToolTip.Tip="Drag to resize invoice panels" AutomationProperties.Name="Resize invoice panels"><GridSplitter.Template><ControlTemplate><Border Background="Transparent"><Border Width="2" Height="48" CornerRadius="1" Background="{DynamicResource AppOutlineBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></GridSplitter.Template></GridSplitter>
        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource RightPane}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="NarrowWorkspace">
      <ScrollViewer x:Name="NarrowWorkspaceScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <Border Padding="12" CornerRadius="12" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding DateText}" FontSize="13"/><TextBlock Grid.Column="1" Text="{Binding NumberText}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/></Grid></Border>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LeftPane}" MinHeight="320" />
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RightPane}" MinHeight="640" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </UserControl.Resources>  <UserControl.Styles>
    <Style Selector="ContentControl#WorkspaceHost"><Setter Property="ContentTemplate" Value="{StaticResource WideWorkspace}" /></Style>
    <Style Selector="ContentControl#WorkspaceHost.narrow"><Setter Property="ContentTemplate" Value="{StaticResource NarrowWorkspace}" /></Style>
    <Style Selector="TabControl#InvoiceDetailTabs TabItem"><Setter Property="Theme" Value="{StaticResource InvoiceInformationTab}"/><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="6,8"/></Style>
    <Style Selector="TextBlock.out-of-stock"><Setter Property="Foreground" Value="#D32F2F" /></Style>
  </UserControl.Styles>
  <ContentControl x:Name="WorkspaceHost" Content="{Binding}" Classes.narrow="{Binding IsNarrow}" />
</UserControl>
