<UserControl xmlns:icons="using:LedgerNest.Desktop" xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.ProductViewDialog"
             x:CompileBindings="False">
  <StackPanel Spacing="11.2">
    <TextBlock loc:UiLocalization.Text="Product details" FontSize="13" Foreground="{DynamicResource AppMutedBrush}" />

    <TextBlock loc:UiLocalization.Text="GENERAL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />

    <Grid ColumnDefinitions="*,12,*">
      <StackPanel>
        <TextBlock loc:UiLocalization.Text="Product Name" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
        <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="{DynamicResource TextInputHeight}" Padding="{DynamicResource TextInputPadding}">
          <Grid ColumnDefinitions="28,*">
            <TextBlock Text="{icons:FontAwesomeGlyph payments}" FontFamily="{DynamicResource IconFontFamily}" FontSize="18" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock loc:UiLocalization.Text="Alias Name (for invoice PDF)" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
        <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="{DynamicResource TextInputHeight}" Padding="{DynamicResource TextInputPadding}">
          <Grid ColumnDefinitions="28,*">
            <TextBlock Text="{icons:FontAwesomeGlyph translate}" FontFamily="{DynamicResource IconFontFamily}" FontSize="18" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding AliasName}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </Grid>

    <StackPanel>
      <TextBlock loc:UiLocalization.Text="Description" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
      <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="73.6" Padding="8,9.6">
        <Grid ColumnDefinitions="28,*">
          <TextBlock FontFamily="{DynamicResource IconFontFamily}" Text="{icons:FontAwesomeGlyph description}" FontSize="18" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel>
      <TextBlock loc:UiLocalization.Text="HSN / SAC" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
      <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="{DynamicResource TextInputHeight}" Padding="{DynamicResource TextInputPadding}">
        <Grid ColumnDefinitions="28,*">
          <TextBlock Text="{icons:FontAwesomeGlyph qr_code_2}" FontFamily="{DynamicResource IconFontFamily}" FontSize="18" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding HsnSac}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>

    <TextBlock loc:UiLocalization.Text="PRICING" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" Margin="0,4,0,0" />

    <Grid ColumnDefinitions="*,12,*">
      <StackPanel>
        <TextBlock loc:UiLocalization.Text="Price" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
        <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="{DynamicResource TextInputHeight}" Padding="{DynamicResource TextInputPadding}">
          <TextBlock Text="{Binding Price}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock loc:UiLocalization.Text="Purchase Price" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
        <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="{DynamicResource TextInputHeight}" Padding="{DynamicResource TextInputPadding}">
          <TextBlock Text="{Binding PurchasePrice}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Grid>

    <StackPanel>
      <TextBlock loc:UiLocalization.Text="Default Discount" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
      <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="{DynamicResource TextInputHeight}" Padding="{DynamicResource TextInputPadding}">
        <TextBlock Text="{Binding DefaultDiscount}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,12,*">
      <StackPanel>
        <TextBlock loc:UiLocalization.Text="Tax Rate (%)" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
        <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="{DynamicResource TextInputHeight}" Padding="{DynamicResource TextInputPadding}">
          <Grid ColumnDefinitions="28,*">
            <TextBlock Text="%" FontSize="22" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding TaxRate}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>

      <CheckBox Grid.Column="2" Content="Price includes tax" IsChecked="{Binding PriceIncludesTax}" IsEnabled="False" VerticalAlignment="Center" Margin="4,16,0,0" />
    </Grid>
  </StackPanel>
</UserControl>
