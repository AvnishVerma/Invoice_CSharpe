<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.ScreenScaffoldView" x:Name="Root">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppCanvasBrush}">
    <ContentControl Content="{Binding VisibleHeader, ElementName=Root}" IsVisible="{Binding ShowHeader, ElementName=Root}" VerticalAlignment="Top" />
    <ContentControl Content="{Binding PageBody, ElementName=Root}" Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
  </Grid>
</UserControl>
