<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.PdfTemplatePreviewView" x:Name="Root" x:CompileBindings="False">
  <UserControl.Resources>
    <DataTemplate x:Key="Rows">
      <Grid RowDefinitions="18,24,24,24,24,24" Background="White">
        <Border Background="{Binding}" />
        <Border Grid.Row="1" Background="#F8FAFC" Margin="0,2,0,0" />
        <Border Grid.Row="2" Background="White" Margin="0,2,0,0" />
        <Border Grid.Row="3" Background="#F8FAFC" Margin="0,2,0,0" />
        <Border Grid.Row="4" Background="White" Margin="0,2,0,0" />
        <Border Grid.Row="5" Background="#F8FAFC" Margin="0,2,0,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Totals">
      <Border Background="#F1F5F9" Width="100" Height="50" CornerRadius="4">
        <Border Height="16" Background="{Binding}" VerticalAlignment="Bottom" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="Classic">
      <Canvas Width="260" Height="370" Background="White">
        <Border Canvas.Left="20" Canvas.Top="20" Width="45" Height="35" Background="#E5E7EB" />
        <Border Canvas.Left="110" Canvas.Top="24" Width="130" Height="7" Background="#E5E7EB" />
        <Border Canvas.Left="110" Canvas.Top="37" Width="90" Height="5" Background="#E5E7EB" />
        <Border Canvas.Left="20" Canvas.Top="70" Width="220" Height="3" Background="{Binding}" />
        <Border Canvas.Left="20" Canvas.Top="92" Width="70" Height="6" Background="#E5E7EB" />
        <ContentControl Canvas.Left="20" Canvas.Top="114" Width="220" Content="{Binding}" ContentTemplate="{StaticResource Rows}" />
        <ContentControl Canvas.Left="140" Canvas.Top="300" Content="{Binding}" ContentTemplate="{StaticResource Totals}" />
      </Canvas>
    </DataTemplate>
    <DataTemplate x:Key="Modern">
      <Canvas Width="260" Height="370" Background="White">
        <Border Canvas.Left="20" Canvas.Top="20" Width="220" Height="80" Background="{Binding}">
          <StackPanel Margin="14" Spacing="10"><Border Height="8" Width="90" Background="White" HorizontalAlignment="Left" /><Border Height="6" Width="140" Background="#B3FFFFFF" HorizontalAlignment="Left" /></StackPanel>
        </Border>
        <ContentControl Canvas.Left="20" Canvas.Top="120" Width="220" Content="{Binding}" ContentTemplate="{StaticResource Rows}" />
        <ContentControl Canvas.Left="140" Canvas.Top="270" Content="{Binding}" ContentTemplate="{StaticResource Totals}" />
        <Border Canvas.Left="20" Canvas.Top="330" Width="220" Height="20" Background="{Binding}" />
      </Canvas>
    </DataTemplate>
    <DataTemplate x:Key="Minimal">
      <Canvas Width="260" Height="370" Background="White">
        <Border Canvas.Left="20" Canvas.Top="20" Width="95" Height="6" Background="#E5E7EB" />
        <Border Canvas.Left="20" Canvas.Top="32" Width="70" Height="5" Background="#E5E7EB" />
        <Border Canvas.Left="200" Canvas.Top="20" Width="40" Height="30" Background="#E5E7EB" />
        <Border Canvas.Left="20" Canvas.Top="75" Width="220" Height="1" Background="#CBD5E1" />
        <ContentControl Canvas.Left="20" Canvas.Top="100" Width="220" Content="#E5E7EB" ContentTemplate="{StaticResource Rows}" />
        <ContentControl Canvas.Left="140" Canvas.Top="280" Content="{Binding}" ContentTemplate="{StaticResource Totals}" />
        <Border Canvas.Left="20" Canvas.Top="348" Width="220" Height="2" Background="{Binding}" />
      </Canvas>
    </DataTemplate>
    <DataTemplate x:Key="Executive">
      <Canvas Width="260" Height="370" Background="White">
        <Border Canvas.Left="20" Canvas.Top="20" Width="6" Height="58" Background="{Binding}" />
        <Border Canvas.Left="38" Canvas.Top="20" Width="80" Height="9" Background="#E5E7EB" />
        <Border Canvas.Left="38" Canvas.Top="36" Width="110" Height="6" Background="#E5E7EB" />
        <Border Canvas.Left="180" Canvas.Top="20" Width="60" Height="15" Background="{Binding}" />
        <Border Canvas.Left="20" Canvas.Top="100" Width="104" Height="58" Background="#F8FAFC" />
        <Border Canvas.Left="136" Canvas.Top="100" Width="104" Height="58" Background="#F8FAFC" />
        <ContentControl Canvas.Left="20" Canvas.Top="180" Width="220" Content="{Binding}" ContentTemplate="{StaticResource Rows}" />
        <ContentControl Canvas.Left="140" Canvas.Top="290" Content="{Binding}" ContentTemplate="{StaticResource Totals}" />
        <Border Canvas.Left="20" Canvas.Top="348" Width="220" Height="2" Background="{Binding}" />
      </Canvas>
    </DataTemplate>
    <DataTemplate x:Key="GridClassic">
      <Border Width="260" Height="370" Background="White" Padding="20">
        <Border BorderBrush="#334155" BorderThickness="1.2" Padding="10">
          <Grid RowDefinitions="8,8,5,12,1,12,28,12,80,12,8,8,8,*">
            <Border Height="6" Width="100" Background="{Binding}" />
            <Border Grid.Row="2" Height="4" Width="70" Background="#E5E7EB" />
            <Border Grid.Row="4" Height="1" Background="#CBD5E1" />
            <Grid Grid.Row="6" ColumnDefinitions="*,*,*">
              <StackPanel Grid.ColumnSpan="2" Spacing="6"><Border Height="5" Width="85" Background="#E5E7EB" HorizontalAlignment="Left" /><Border Height="5" Width="60" Background="#E5E7EB" HorizontalAlignment="Left" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="6"><Border Height="5" Background="#E5E7EB" /><Border Height="5" Width="35" Background="#E5E7EB" /></StackPanel>
            </Grid>
            <Border Grid.Row="8" BorderBrush="#CBD5E1" BorderThickness="1">
              <Grid RowDefinitions="16,*" ColumnDefinitions="1*,3*,1*,1*">
                <Border Grid.ColumnSpan="4" Background="#E2E8F0" />
                <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" />
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" />
                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0" />
              </Grid>
            </Border>
            <Border Grid.Row="10" Height="4" Width="75" Background="#E5E7EB" HorizontalAlignment="Right" />
            <Border Grid.Row="11" Height="4" Width="75" Background="#E5E7EB" HorizontalAlignment="Right" />
            <Border Grid.Row="12" Height="6" Width="60" Background="{Binding}" HorizontalAlignment="Right" />
          </Grid>
        </Border>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="Compact">
      <Canvas Width="260" Height="370" Background="White">
        <Border Canvas.Left="20" Canvas.Top="20" Width="35" Height="26" Background="#E5E7EB" />
        <Border Canvas.Left="64" Canvas.Top="20" Width="100" Height="7" Background="#E5E7EB" />
        <Border Canvas.Left="64" Canvas.Top="34" Width="70" Height="5" Background="#E5E7EB" />
        <Border Canvas.Left="196" Canvas.Top="20" Width="44" Height="9" Background="{Binding}" />
        <Border Canvas.Left="20" Canvas.Top="55" Width="220" Height="30" BorderBrush="#CBD5E1" BorderThickness="1" />
        <ContentControl Canvas.Left="20" Canvas.Top="100" Width="220" Content="{Binding}" ContentTemplate="{StaticResource Rows}" />
        <Border Canvas.Left="20" Canvas.Top="260" Width="220" Height="12" Background="#F1F5F9" />
        <ContentControl Canvas.Left="140" Canvas.Top="300" Content="{Binding}" ContentTemplate="{StaticResource Totals}" />
      </Canvas>
    </DataTemplate>
    <DataTemplate x:Key="Thermal">
      <Border Width="260" Height="370" Background="White" Padding="50,20">
        <StackPanel Spacing="10">
          <Border Height="1" Background="#CBD5E1" />
          <Border Height="6" Width="85" Background="{Binding}" />
          <Border Height="4" Width="60" Background="#E5E7EB" />
          <Border Height="4" Width="50" Background="#E5E7EB" />
          <Border Height="1" Background="#CBD5E1" />
          <ContentControl Content="#E5E7EB" ContentTemplate="{StaticResource Rows}" />
          <Border Height="1" Background="#CBD5E1" />
          <Border Height="6" Background="{Binding}" />
          <Border Height="1" Background="#CBD5E1" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ContentControl#Sketch"><Setter Property="ContentTemplate" Value="{StaticResource Classic}" /></Style>
    <Style Selector="local|PdfTemplatePreviewView[TemplateName=Modern] ContentControl#Sketch"><Setter Property="ContentTemplate" Value="{StaticResource Modern}" /></Style>
    <Style Selector="local|PdfTemplatePreviewView[TemplateName=Minimal] ContentControl#Sketch"><Setter Property="ContentTemplate" Value="{StaticResource Minimal}" /></Style>
    <Style Selector="local|PdfTemplatePreviewView[TemplateName=Executive] ContentControl#Sketch"><Setter Property="ContentTemplate" Value="{StaticResource Executive}" /></Style>
    <Style Selector="local|PdfTemplatePreviewView[TemplateKey=GridClassic] ContentControl#Sketch"><Setter Property="ContentTemplate" Value="{StaticResource GridClassic}" /></Style>
    <Style Selector="local|PdfTemplatePreviewView[TemplateName=Compact] ContentControl#Sketch"><Setter Property="ContentTemplate" Value="{StaticResource Compact}" /></Style>
    <Style Selector="local|PdfTemplatePreviewView[TemplateName=Thermal] ContentControl#Sketch"><Setter Property="ContentTemplate" Value="{StaticResource Thermal}" /></Style>
  </UserControl.Styles>
  <Viewbox Stretch="Uniform"><ContentControl x:Name="Sketch" Content="{Binding Accent, ElementName=Root}" /></Viewbox>
</UserControl>
