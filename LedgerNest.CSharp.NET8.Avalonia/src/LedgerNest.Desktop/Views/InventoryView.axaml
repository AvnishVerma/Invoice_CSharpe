<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" x:Class="LedgerNest.Desktop.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
    <Border Classes="page-header">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Inventory Management" Classes="page-header-title"/>
        <Button Grid.Column="1" Tag="Refresh" Command="{Binding RefreshCommand}" Classes="action-icon header-icon-action" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh"><TextBlock Text="refresh" Classes="action-icon-glyph" Foreground="White"/></Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="340,12,*" Margin="{DynamicResource PageContentPadding}">
      <Border Padding="16" CornerRadius="14" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Post a stock adjustment" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Use Stock In for received goods and Stock Out for damage, transfer, or corrections." TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}"/>
          <TextBlock Text="Product" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberBinding="{Binding Display}" PlaceholderText="Select product"/>
          <Border Padding="12" CornerRadius="10" Background="{DynamicResource AppBackgroundBrush}" IsVisible="{Binding SelectedProduct}">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Current stock" Foreground="{DynamicResource AppMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProduct.StockDisplay}" FontSize="16" FontWeight="SemiBold"/></Grid>
          </Border>
          <Grid ColumnDefinitions="*,10,*">
            <StackPanel Spacing="4"><TextBlock Text="Movement direction" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}"/></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Reason / type" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding MovementType}"/></StackPanel>
          </Grid>
          <TextBlock Text="Quantity in the product’s base unit" FontWeight="SemiBold"/><NumericUpDown Value="{Binding Quantity}" Minimum="0.001" Increment="1" FormatString="0.###"/>
          <TextBlock Text="Reference (optional)" FontWeight="SemiBold"/>
          <TextBox Text="{Binding Reference}" PlaceholderText="Reference number"/>
          <TextBlock Text="Notes (optional)" FontWeight="SemiBold"/>
          <TextBox Text="{Binding Notes}" PlaceholderText="Adjustment notes" AcceptsReturn="True" MinHeight="70"/>
          <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Status}" Foreground="#2E7D32" TextWrapping="Wrap"/>
          <Button Content="Post Adjustment" Command="{Binding PostCommand}" Classes="action primary" IsEnabled="{Binding CanManage}"/>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Padding="16" CornerRadius="14" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,12,*">
          <StackPanel><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Movement history" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Latest 250 entries" Foreground="{DynamicResource AppMutedBrush}"/></Grid><Grid ColumnDefinitions="125,130,90,140,*,120" Margin="10,12,10,0"><TextBlock Text="DATE"/><TextBlock Grid.Column="1" Text="TYPE"/><TextBlock Grid.Column="2" Text="CHANGE"/><TextBlock Grid.Column="3" Text="REFERENCE"/><TextBlock Grid.Column="4" Text="NOTES"/><TextBlock Grid.Column="5" Text="USER"/></Grid></StackPanel>
          <ListBox Grid.Row="2" ItemsSource="{Binding Movements}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:InventoryMovementRow">
              <Border Padding="10" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="125,130,90,140,*,120">
                  <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy HH:mm}'}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Type}"/>
                  <TextBlock Grid.Column="2" Text="{Binding ChangeDisplay}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="3" Text="{Binding Reference}"/>
                  <TextBlock Grid.Column="4" Text="{Binding Notes}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="5" Text="{Binding User}" Foreground="{DynamicResource AppMutedBrush}"/>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
