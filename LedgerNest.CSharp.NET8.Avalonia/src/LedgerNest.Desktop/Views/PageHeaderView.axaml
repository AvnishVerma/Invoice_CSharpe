<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.PageHeaderView" x:Name="Root">
  <Border Classes="page-header">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock x:Name="Heading" Text="{Binding Title, ElementName=Root}" Classes="page-header-title" TextWrapping="NoWrap" />
      <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                  HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
