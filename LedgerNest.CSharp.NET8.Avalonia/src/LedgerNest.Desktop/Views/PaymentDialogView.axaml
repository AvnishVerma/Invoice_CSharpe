<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.PaymentDialogView"
             x:CompileBindings="False">
  <StackPanel Spacing="16">
    <TextBlock Text="{Binding InvoiceLine}" FontSize="13" Foreground="{DynamicResource AppMutedBrush}" />

    <Grid ColumnDefinitions="*,12,*,12,*">
      <Border Padding="12.8,9.6" CornerRadius="6" BorderBrush="#590A84FF" BorderThickness="1" Background="{DynamicResource AppCardBrush}">
        <StackPanel Spacing="6.4">
          <TextBlock loc:UiLocalization.Text="Invoice Total" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
          <TextBlock Text="{Binding TotalText}" FontSize="16" FontWeight="Bold" Foreground="#0A84FF" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Padding="12.8,9.6" CornerRadius="6" BorderBrush="#5916A34A" BorderThickness="1" Background="{DynamicResource AppCardBrush}">
        <StackPanel Spacing="6.4">
          <TextBlock loc:UiLocalization.Text="Amount Paid" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
          <TextBlock Text="{Binding PaidText}" FontSize="16" FontWeight="Bold" Foreground="#16A34A" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Padding="12.8,9.6" CornerRadius="6" BorderBrush="{Binding OutstandingBorder}" BorderThickness="1" Background="{Binding OutstandingBackground}">
        <StackPanel Spacing="6.4">
          <TextBlock loc:UiLocalization.Text="Outstanding" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
          <TextBlock Text="{Binding OutstandingText}" FontSize="16" FontWeight="Bold" Foreground="{Binding OutstandingBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock loc:UiLocalization.Text="Payment History" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />

    <Border IsVisible="{Binding HasNoPayments}" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="14.4">
      <TextBlock loc:UiLocalization.Text="No payments recorded yet" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource AppMutedBrush}" />
    </Border>

    <Border IsVisible="{Binding HasPayments}" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" CornerRadius="7">
      <StackPanel>
        <Grid ColumnDefinitions="1.2*,.8*,.9*,1*,1*" Background="{DynamicResource AppCanvasBrush}">
          <TextBlock loc:UiLocalization.Text="Receipt #" FontSize="12" Padding="11.2,8" />
          <TextBlock Grid.Column="1" loc:UiLocalization.Text="Date" FontSize="12" Padding="11.2,8" />
          <TextBlock Grid.Column="2" loc:UiLocalization.Text="Amount" FontSize="12" Padding="11.2,8" />
          <TextBlock Grid.Column="3" loc:UiLocalization.Text="Tax Covered" FontSize="12" Padding="11.2,8" />
          <TextBlock Grid.Column="4" loc:UiLocalization.Text="Method" FontSize="12" Padding="11.2,8" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Payments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,1,0,0" Padding="11.2,8.8">
                <Grid ColumnDefinitions="1.2*,.8*,.9*,1*,1*">
                  <TextBlock Text="{Binding Receipt}" FontSize="12" Foreground="#003B87" />
                  <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="12" FontWeight="Bold" Foreground="#16A34A" />
                  <TextBlock Grid.Column="3" Text="{Binding TaxCovered}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
                  <TextBlock Grid.Column="4" Text="{Binding Method}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding IsFullyPaid}" BorderBrush="#5916A34A" BorderThickness="1" Background="#1416A34A" CornerRadius="7" Padding="12.8,11.2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6.4">
        <TextBlock Text="✓" FontSize="18" FontWeight="Bold" Foreground="#16A34A" />
        <TextBlock loc:UiLocalization.Text="Invoice fully paid" FontSize="14" Foreground="#16A34A" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding CanRecordPayment}" Height="1" Background="{DynamicResource AppCardBrush}" />

    <StackPanel IsVisible="{Binding CanRecordPayment}" Spacing="9.6">
      <TextBlock loc:UiLocalization.Text="New Payment" FontSize="14" FontWeight="Bold" />
      <ContentControl Content="{Binding PaymentForm}" />
    </StackPanel>
  </StackPanel>
</UserControl>
