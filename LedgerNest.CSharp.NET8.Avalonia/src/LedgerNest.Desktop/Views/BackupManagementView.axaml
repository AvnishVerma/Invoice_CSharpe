<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.BackupManagementView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="13" MaxWidth="940" HorizontalAlignment="Left">
      <ContentControl x:Name="ActionsHost" />
      <Separator />
      <ContentControl x:Name="HistoryHost" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
