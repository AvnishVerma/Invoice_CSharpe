<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.CompanySettingsInfoView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CompanySurface">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="CompanyOutline">#E0E0E0</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CompanySurface">#18212B</SolidColorBrush>
          <SolidColorBrush x:Key="CompanyOutline">#526171</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*">
    <ContentControl x:Name="AppBarHost" />
    <Grid Grid.Row="1" ColumnDefinitions="240,*">
      <Border Background="{DynamicResource CompanySurface}"
              BorderBrush="{DynamicResource CompanyOutline}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="19.2">
              <StackPanel Spacing="12.8">
                <TextBlock loc:UiLocalization.Text="COMPANY LOGO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
                <ContentControl x:Name="LogoButtonHost" />
                <ContentControl x:Name="LogoPositionHost" />
                <ContentControl x:Name="PreviewNameHost" />
                <TextBlock Text="Max 1080x1080 px - 2 MB&#x0a;PNG or JPG only" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </ScrollViewer>
          <Border Grid.Row="1" Padding="12.8">
            <ContentControl x:Name="SaveHost" />
          </Border>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Padding="25.6">
          <ContentControl x:Name="DetailsHost" />
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
