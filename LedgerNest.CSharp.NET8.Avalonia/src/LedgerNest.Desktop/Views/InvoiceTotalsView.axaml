<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LedgerNest.Desktop.Views.InvoiceTotalsView" x:CompileBindings="False">
  <ItemsControl ItemsSource="{Binding Totals}" HorizontalAlignment="Stretch">
    <ItemsControl.ItemTemplate><DataTemplate>
      <Grid ColumnDefinitions="*,Auto" Margin="0,4">
        <TextBlock Text="{Binding Label}" FontSize="{Binding FontSize}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="{Binding FontSize}" FontWeight="Bold" Foreground="{Binding AmountColor}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
