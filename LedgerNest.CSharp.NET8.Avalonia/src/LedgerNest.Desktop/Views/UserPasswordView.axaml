<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" xmlns:views="using:LedgerNest.Desktop.Views"
 x:Class="LedgerNest.Desktop.Views.UserPasswordView" x:DataType="vm:UserPasswordViewModel">
 <StackPanel Spacing="12.8">
  <Border Background="{DynamicResource IdentityBrush}" BorderBrush="#64B5F6" BorderThickness="1" CornerRadius="7" Padding="11.2,9.6"><TextBlock Text="{Binding Username, StringFormat='User: {0}'}" FontSize="14" Foreground="#1976D2"/></Border>
  <views:FormFieldsView DataContext="{Binding Fields}"/>
 </StackPanel>
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="IdentityBrush">#E3F2FD</SolidColorBrush></ResourceDictionary>
  <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="IdentityBrush">#202B36</SolidColorBrush></ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries></ResourceDictionary></UserControl.Resources>
</UserControl>
