<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.LicenseActivationFormView">
  <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
    <ContentControl x:Name="StatusHost" />
    <Border Padding="22" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="Activate this device" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Send this Device ID to your software provider to receive a trial, paid or renewal license."
                   FontSize="14" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
        <ContentControl x:Name="DeviceIdHost" />
        <ContentControl x:Name="CopyHost" />
        <ContentControl x:Name="ImportHost" />
      </StackPanel>
    </Border>
    <Border Padding="22" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="Or paste your license" FontSize="18" FontWeight="SemiBold" />
        <ContentControl x:Name="PasteHost" />
        <ContentControl x:Name="ActivateHost" />
      </StackPanel>
    </Border>
    <ContentControl x:Name="RefreshHost" />
  </StackPanel>
</UserControl>
