<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop"
             xmlns:views="using:LedgerNest.Desktop.Views"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="LedgerNest.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             KeyDown="OnKeyDown">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="LoginBackground">#F3F4F6</SolidColorBrush>
          <SolidColorBrush x:Key="LoginCardSurface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="LoginText">#1F2937</SolidColorBrush>
          <SolidColorBrush x:Key="LoginMuted">#6B7280</SolidColorBrush>
          <SolidColorBrush x:Key="LoginPrimary">#2563EB</SolidColorBrush>
          <SolidColorBrush x:Key="LoginOutline">#E5E7EB</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="LoginBackground">#1E293B</SolidColorBrush>
          <SolidColorBrush x:Key="LoginCardSurface">#334155</SolidColorBrush>
          <SolidColorBrush x:Key="LoginText">#F1F5F9</SolidColorBrush>
          <SolidColorBrush x:Key="LoginMuted">#94A3B8</SolidColorBrush>
          <SolidColorBrush x:Key="LoginPrimary">#3B82F6</SolidColorBrush>
          <SolidColorBrush x:Key="LoginOutline">#475569</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Background="{DynamicResource LoginBackground}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Padding="24">
        <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="32" CornerRadius="16"
                Background="{DynamicResource LoginCardSurface}"
                BoxShadow="0 4 12 0 #33000000">
          <StackPanel Spacing="20">
            <!-- Brand Logo -->
            <views:BrandLogo HorizontalAlignment="Center" />

            <!-- Welcome Message -->
            <TextBlock Text="Welcome Back" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Please log in to continue" FontSize="14" Foreground="{DynamicResource LoginMuted}" HorizontalAlignment="Center" />

            <!-- Error Message -->
            <TextBlock Text="{Binding Message}" MinHeight="20" Foreground="Firebrick"
                       Opacity="{Binding Message, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />

            <!-- Username Input -->
            <StackPanel Spacing="4"> 
              <TextBox x:Name="UsernameInput" Classes="login-field" PlaceholderText="Username"
                       Text="{Binding Username.Value, Mode=TwoWay}" AutomationProperties.Name="Username" />
              <TextBlock Text="{Binding Username.Error}" FontSize="12" Foreground="Firebrick"
                         IsVisible="{Binding Username.Error, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Password Input -->
            <StackPanel Spacing="4">
              <TextBox Classes="login-field" PlaceholderText="Password"
                       PasswordChar="*"
                       Text="{Binding Password.Value, Mode=TwoWay}" AutomationProperties.Name="Password" />
              <TextBlock Text="{Binding Password.Error}" FontSize="12" Foreground="Firebrick"
                         IsVisible="{Binding Password.Error, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Login Button -->
            <Button Content="Login" Classes="login-primary" Command="{Binding LoginCommand}" />

            <!-- Forgot Password -->
            <Button Content="Forgot password?" Classes="text" HorizontalAlignment="Center" Command="{Binding ForgotPasswordCommand}" />

            <!-- Footer -->
            <TextBlock Text="{Binding Tagline}" FontSize="12" Foreground="{DynamicResource LoginMuted}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Border>
    </ScrollViewer>
  </Border>
</UserControl>