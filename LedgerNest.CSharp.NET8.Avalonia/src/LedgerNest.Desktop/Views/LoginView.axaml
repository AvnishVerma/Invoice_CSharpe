<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="LedgerNest.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             KeyDown="OnKeyDown">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="LoginCardSurface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="LoginText">#111827</SolidColorBrush>
          <SolidColorBrush x:Key="LoginMuted">#6B7280</SolidColorBrush>
          <SolidColorBrush x:Key="LoginPrimary">#003B8F</SolidColorBrush>
          <SolidColorBrush x:Key="LoginPrimaryLight">#EAF2FF</SolidColorBrush>
          <SolidColorBrush x:Key="LoginOutline">#DDE5F0</SolidColorBrush>
          <SolidColorBrush x:Key="LoginErrorBack">#FEF2F2</SolidColorBrush>
          <SolidColorBrush x:Key="LoginErrorBorder">#FCA5A5</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="LoginCardSurface">#1E293B</SolidColorBrush>
          <SolidColorBrush x:Key="LoginText">#F8FAFC</SolidColorBrush>
          <SolidColorBrush x:Key="LoginMuted">#CBD5E1</SolidColorBrush>
          <SolidColorBrush x:Key="LoginPrimary">#60A5FA</SolidColorBrush>
          <SolidColorBrush x:Key="LoginPrimaryLight">#1D3559</SolidColorBrush>
          <SolidColorBrush x:Key="LoginOutline">#334155</SolidColorBrush>
          <SolidColorBrush x:Key="LoginErrorBack">#3B1D24</SolidColorBrush>
          <SolidColorBrush x:Key="LoginErrorBorder">#7F1D1D</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <LinearGradientBrush x:Key="LoginBackdrop" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#EAF2FF" Offset="0" />
        <GradientStop Color="#F8FAFC" Offset="0.55" />
        <GradientStop Color="#F3E8FF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="LoginHeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#003B8F" Offset="0" />
        <GradientStop Color="#0F766E" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBox.login-input">
      <Setter Property="Height" Value="38.4" />
      <Setter Property="MinHeight" Value="38.4" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource LoginCardSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LoginOutline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource LoginText}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.login-primary"> 
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource LoginPrimary}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.login-primary ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.login-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LoginPrimary}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource LoginBackdrop}">
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Height="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=UserControl}}">
      <Grid Width="930" Height="590">
        <Border Width="880"
                Height="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="28"
                ClipToBounds="True"
                Background="{DynamicResource LoginCardSurface}"
                BoxShadow="0 24 80 0 #24000000">
          <Grid ColumnDefinitions="380,500">
            <Border Background="{StaticResource LoginHeroGradient}" Padding="30.4">
              <Grid RowDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="17.6">
                  <Border Width="72" Height="57.6" CornerRadius="24" Background="#26FFFFFF" HorizontalAlignment="Left">
                    <TextBlock Text="✓" FontSize="38" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock loc:UiLocalization.Text="Welcome back" FontSize="34" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                  <TextBlock loc:UiLocalization.Text="Open your secure workspace and continue managing invoices, payments, customers, and reports."
                             FontSize="16" LineHeight="24" Foreground="#E7F2FF" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,8,0,0">
                    <Border Background="#1AFFFFFF" CornerRadius="18" Padding="9.6,6.4" Margin="0,0,8,8">
                      <TextBlock loc:UiLocalization.Text="Offline ready" Foreground="White" FontSize="13" />
                    </Border>
                    <Border Background="#1AFFFFFF" CornerRadius="18" Padding="9.6,6.4" Margin="0,0,8,8">
                      <TextBlock loc:UiLocalization.Text="Local data" Foreground="White" FontSize="13" />
                    </Border>
                  </WrapPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" loc:UiLocalization.Text="Secure desktop access" Foreground="#CFE8FF" FontSize="12" />
              </Grid>
            </Border>

            <Border Grid.Column="1" Padding="40,33.6">
              <Border Width="400" MinHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="6.4">
                    <TextBlock loc:UiLocalization.Text="Sign in" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource LoginText}" />
                    <TextBlock loc:UiLocalization.Text="Use your workspace credentials to continue." FontSize="14" Foreground="{DynamicResource LoginMuted}" TextWrapping="Wrap" />
                  </StackPanel>

                  <Border MinHeight="33.6">
                    <Border Background="{DynamicResource LoginErrorBack}"
                            BorderBrush="{DynamicResource LoginErrorBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="9.6,8"
                            IsVisible="{Binding Message, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Message}" Foreground="Firebrick" FontSize="13" TextWrapping="Wrap" />
                    </Border>
                  </Border>

                  <StackPanel Spacing="5.6">
                    <TextBlock loc:UiLocalization.Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LoginMuted}" />
                    <TextBox x:Name="UsernameInput" Classes="login-input" PlaceholderText="Username"
                             Text="{Binding Username.Value, Mode=TwoWay}" AutomationProperties.Name="Username" />
                    <TextBlock Text="{Binding Username.Error}" FontSize="12" Foreground="Firebrick"
                               IsVisible="{Binding Username.Error, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>

                  <StackPanel Spacing="5.6">
                    <TextBlock loc:UiLocalization.Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LoginMuted}" />
                    <TextBox Classes="login-input" PlaceholderText="Password"
                             PasswordChar="●"
                             Text="{Binding Password.Value, Mode=TwoWay}" AutomationProperties.Name="Password" />
                    <TextBlock Text="{Binding Password.Error}" FontSize="12" Foreground="Firebrick"
                               IsVisible="{Binding Password.Error, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,Auto">
                      <Button Content="Login" Classes="login-primary" Command="{Binding LoginCommand}" />
                      <Button Grid.Column="1" Content="Forgot password?" Classes="login-link" Command="{Binding ForgotPasswordCommand}" />
                  </Grid>

                  <Border Background="{DynamicResource LoginPrimaryLight}" CornerRadius="14" Padding="11.2">
                    <TextBlock Text="{Binding FirstTimeHelp}" FontSize="12" Foreground="{DynamicResource LoginPrimary}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Viewbox>
  </Border>
</UserControl>
