<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" x:Class="LedgerNest.Desktop.Views.ProductPriceMasterView" x:DataType="vm:ProductPriceMasterViewModel">
 <Grid RowDefinitions="44.8,*" Background="{DynamicResource AppCanvasBrush}">
  <Border Background="{DynamicResource PageHeaderBrush}" Padding="20,0"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="Price Manager" FontSize="20" Foreground="White"/><TextBlock Text="Selling units, conversions and dated prices" FontSize="11" Foreground="#DCE8FA"/></StackPanel><Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Classes="header-action"/></Grid></Border>
  <ScrollViewer Grid.Row="1"><StackPanel Margin="16" Spacing="14" MaxWidth="1200" HorizontalAlignment="Stretch">
   <Border Padding="16" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Choose a product" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="The units and price history below will apply to this product." Foreground="{DynamicResource AppMutedBrush}"/><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" PlaceholderText="Select product" MaxWidth="520" HorizontalAlignment="Left"/></StackPanel></Border>
   <Grid ColumnDefinitions="*,14,*">
    <Border Padding="18" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="1  Configure a selling unit" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Example: one BOX contains 20 PCS." Foreground="{DynamicResource AppMutedBrush}"/><TextBlock Text="Unit from Unit Master" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" PlaceholderText="Choose unit"/><Grid ColumnDefinitions="*,12,*"><StackPanel Spacing="4"><TextBlock Text="Base units contained" FontWeight="SemiBold"/><NumericUpDown Value="{Binding ConversionFactor}" Minimum="0.000001"/><TextBlock Text="Conversion factor" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Default selling price" FontWeight="SemiBold"/><NumericUpDown Value="{Binding UnitSellingPrice}" Minimum="0"/><TextBlock Text="Fallback unit price" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Spacing="18"><CheckBox Content="Default unit" IsChecked="{Binding IsDefault}"/><CheckBox Content="Available for sale" IsChecked="{Binding IsActive}"/></StackPanel><Button Content="Save Selling Unit" Command="{Binding SaveSellingUnitCommand}" Classes="primary" HorizontalAlignment="Right" IsEnabled="{Binding CanManage}"/></StackPanel></Border>
    <Border Grid.Column="2" Padding="18" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="2  Schedule a price" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Keep price history without changing earlier invoices." Foreground="{DynamicResource AppMutedBrush}"/><TextBlock Text="Selling unit" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding SellingUnits}" SelectedItem="{Binding SelectedSellingUnit}" PlaceholderText="Choose configured unit"/><TextBlock Text="Price list" FontWeight="SemiBold"/><TextBox Text="{Binding PriceList}" PlaceholderText="Retail, Wholesale…"/><Grid ColumnDefinitions="*,12,*"><StackPanel Spacing="4"><TextBlock Text="New selling price" FontWeight="SemiBold"/><NumericUpDown Value="{Binding EffectiveSellingPrice}" Minimum="0"/></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Effective from" FontWeight="SemiBold"/><DatePicker SelectedDate="{Binding EffectiveDate}"/></StackPanel></Grid><CheckBox Content="Active price" IsChecked="{Binding IsActive}"/><Button Content="Save Effective Price" Command="{Binding SavePriceCommand}" Classes="primary" HorizontalAlignment="Right" IsEnabled="{Binding CanManage}"/></StackPanel></Border>
   </Grid>
   <TextBlock Text="{Binding Error}" Foreground="#C62828"/><TextBlock Text="{Binding Status}" Foreground="#2E7D32"/><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
   <Grid ColumnDefinitions="*,14,*"><Border Padding="16" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1"><StackPanel Spacing="8"><TextBlock Text="Configured selling units" FontSize="16" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding SellingUnits}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SellingUnitRow"><Border Padding="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,100,110"><TextBlock Text="{Binding Unit}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Conversion, StringFormat='× {0}'}"/><TextBlock Grid.Column="2" Text="{Binding Price}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="2" Padding="16" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1"><StackPanel Spacing="8"><TextBlock Text="Price history" FontSize="16" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Prices}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PriceRow"><Border Padding="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="90,*,100,120"><TextBlock Text="{Binding Unit}"/><TextBlock Grid.Column="1" Text="{Binding PriceList}"/><TextBlock Grid.Column="2" Text="{Binding Price}" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{Binding EffectiveDate, StringFormat='{}{0:dd MMM yyyy}'}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
