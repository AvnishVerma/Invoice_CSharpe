<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" x:Class="LedgerNest.Desktop.Views.CompanySettingsView" x:DataType="vm:CompanySettingsViewModel" x:CompileBindings="False" xmlns:shared="using:LedgerNest.Desktop.Views" x:Name="PageRoot">
  <shared:ScreenScaffoldView>
    <shared:ScreenScaffoldView.PageHeader>
      <shared:PageHeaderView Title="Company Information" DataContext="{Binding DataContext, ElementName=PageRoot}">
        <shared:PageHeaderView.HeaderActions>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" MinWidth="145" AutomationProperties.Name="Language" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" MinWidth="100" />
          </StackPanel>
        </shared:PageHeaderView.HeaderActions>
      </shared:PageHeaderView>
    </shared:ScreenScaffoldView.PageHeader>
    <shared:ScreenScaffoldView.PageBody>
      <Grid ColumnDefinitions="240,*">
        <Border BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="*,Auto">
            <ScrollViewer>
              <StackPanel Margin="{DynamicResource PageContentPadding}" Spacing="12">
                <TextBlock Text="COMPANY LOGO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
                <Button Click="BrowseLogo" Width="180" Height="180" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                  <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasLogo}">
                      <TextBlock Text="upload" Classes="action-icon-glyph" FontSize="40" Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="Upload Logo" />
                      <TextBlock Text="Click to browse" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
                    </StackPanel>
                    <Image Source="{Binding LogoImage}" Stretch="Uniform" IsVisible="{Binding HasLogo}" />
                  </Grid>
                </Button>
                <TextBlock Text="Company Logo Position" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
                <ComboBox ItemsSource="{Binding LogoPosition.Options}" SelectedItem="{Binding LogoPosition.Value, Mode=TwoWay}" />
                <TextBlock Text="{Binding CompanyName.Value}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="Max 1080x1080 px - 2 MB&#xA;PNG or JPG only" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
              </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="1" Content="Save" Command="{Binding SaveCommand}" Classes="action primary" Margin="{DynamicResource PageContentPadding}" HorizontalAlignment="Stretch" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="1">
          <StackPanel Margin="{DynamicResource PageContentPadding}" Spacing="18">
            <TextBlock Text="COMPANY DETAILS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel>
                <TextBlock Text="Company Name *" />
                <TextBox Text="{Binding CompanyName.Value, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="GSTIN" />
                <TextBox Text="{Binding Gstin.Value, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel>
                <TextBlock Text="PAN" />
                <TextBox Text="{Binding Pan.Value, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="FSSAI Code" />
                <TextBox Text="{Binding FssaiCode.Value, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,12,*,12,*">
              <StackPanel>
                <TextBlock Text="Country" />
                <ComboBox ItemsSource="{Binding Country.Options}" SelectedItem="{Binding Country.Value, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Phone" />
                <TextBox Text="{Binding Phone.Value, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Email" />
                <TextBox Text="{Binding Email.Value, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <StackPanel>
              <TextBlock Text="Website" />
              <TextBox Text="{Binding Website.Value, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Address" />
              <TextBox Text="{Binding Address.Value, Mode=TwoWay}" AcceptsReturn="True" MinHeight="84" />
            </StackPanel>
            <TextBlock Text="BUSINESS TYPE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
            <Border Classes="card" Padding="16">
              <Grid ColumnDefinitions="Auto,16,*">
                <TextBlock Text="account_tree" Classes="action-icon-glyph" FontSize="25" Foreground="{DynamicResource AppPrimaryBrush}" />
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="Business Type" FontSize="16" />
                  <TextBlock Text="Controls item type options in the product list and invoices" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Product" Command="{Binding SelectBusinessTypeCommand}" CommandParameter="Product" Classes="segment" Classes.selected="{Binding IsProduct}" />
                    <Button Content="Service" Command="{Binding SelectBusinessTypeCommand}" CommandParameter="Service" Classes="segment" Classes.selected="{Binding IsService}" />
                    <Button Content="Both" Command="{Binding SelectBusinessTypeCommand}" CommandParameter="Both" Classes="segment" Classes.selected="{Binding IsBoth}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="PAYMENT SETTINGS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
            <shared:InvoiceToggleSettingView Field="{Binding ShowQr}" Title="Show QR Code on Invoices" Help="Adds scannable UPI payment QR codes to generated PDFs" Icon="credit_card" />
            <TextBlock Text="UPI ACCOUNTS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
            <ItemsControl ItemsSource="{Binding UpiAccounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,12,2*,12,Auto" Margin="0,0,0,8">
                    <TextBox Text="{Binding [0].Value, Mode=TwoWay}" PlaceholderText="Label" />
                    <TextBox Grid.Column="2" Text="{Binding [1].Value, Mode=TwoWay}" PlaceholderText="UPI ID" />
                    <Button Grid.Column="4" Content="−" Command="{Binding $parent[UserControl].DataContext.RemoveUpiCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove UPI account" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="＋ Add UPI Account" Command="{Binding AddUpiCommand}" Classes="text" HorizontalAlignment="Left" />
            <shared:InvoiceToggleSettingView Field="{Binding ShowBank}" Title="Show Bank Details on Invoices" Help="Prints bank account details on generated PDFs" Icon="account_balance" />
            <TextBlock Text="BANK ACCOUNTS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
            <ItemsControl ItemsSource="{Binding BankAccounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,8,*,8,1.25*,8,*,8,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                    <TextBox Text="{Binding [0].Value, Mode=TwoWay}" PlaceholderText="Label" />
                    <TextBox Grid.Column="2" Text="{Binding [1].Value, Mode=TwoWay}" PlaceholderText="Bank Name" />
                    <TextBox Grid.Column="4" Text="{Binding [2].Value, Mode=TwoWay}" PlaceholderText="Account Number" />
                    <TextBox Grid.Column="6" Text="{Binding [3].Value, Mode=TwoWay}" PlaceholderText="IFSC Code" />
                    <TextBox Grid.Row="1" Grid.ColumnSpan="7" Text="{Binding [4].Value, Mode=TwoWay}" PlaceholderText="IBAN (optional)" Margin="0,8,0,0" />
                    <Button Grid.Column="8" Content="−" Command="{Binding $parent[UserControl].DataContext.RemoveBankCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove bank account" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="＋ Add Bank Account" Command="{Binding AddBankCommand}" Classes="text" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </shared:ScreenScaffoldView.PageBody>
  </shared:ScreenScaffoldView>
</UserControl>
