<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.DashboardPageView"
             x:CompileBindings="False">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DashboardSurface">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="DashboardCard">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="DashboardText">#1F1F29</SolidColorBrush>
          <SolidColorBrush x:Key="DashboardMuted">#6E6E78</SolidColorBrush>
          <SolidColorBrush x:Key="DashboardRecent">#FCF6FF</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DashboardSurface">#18212B</SolidColorBrush>
          <SolidColorBrush x:Key="DashboardCard">#202B36</SolidColorBrush>
          <SolidColorBrush x:Key="DashboardText">#F4F7FB</SolidColorBrush>
          <SolidColorBrush x:Key="DashboardMuted">#A8B3BF</SolidColorBrush>
          <SolidColorBrush x:Key="DashboardRecent">#272033</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <DataTemplate x:Key="RecentInvoiceTableTemplate">
        <Border Padding="14.4" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000">
          <StackPanel Spacing="9.6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock loc:UiLocalization.Text="Recent Invoices" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
              <TextBlock Grid.Column="1" Text="{Binding RecentCaption}" FontSize="11" Foreground="{DynamicResource DashboardMuted}" />
            </Grid>
            <Border BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6.4">
              <Grid ColumnDefinitions="1.6*,1.5*,1*,Auto">
                <TextBlock loc:UiLocalization.Text="Invoice" FontSize="12" Foreground="{DynamicResource DashboardMuted}" />
                <TextBlock Grid.Column="1" loc:UiLocalization.Text="Customer" FontSize="12" Foreground="{DynamicResource DashboardMuted}" />
                <TextBlock Grid.Column="2" loc:UiLocalization.Text="Amount" FontSize="12" Foreground="{DynamicResource DashboardMuted}" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding RecentInvoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="1.6*,1.5*,1*,24,24" MinHeight="28.8">
                    <TextBlock Text="{Binding InvoiceTitle}" FontSize="12" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="12" Foreground="{DynamicResource DashboardMuted}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6.4" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TotalText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
                      <Border Padding="6.4,2.4" CornerRadius="6" Background="{Binding StatusBackground}">
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusBrush}" />
                      </Border>
                    </StackPanel>
                    <Button Grid.Column="3" Command="{Binding EditCommand}" Classes="action-icon" Background="Transparent" BorderThickness="0" ToolTip.Tip="Edit"><TextBlock loc:UiLocalization.Text="edit" Classes="action-icon-glyph" Foreground="#6E6E6E" /></Button>
                    <Button Grid.Column="4" Command="{Binding PdfCommand}" Classes="action-icon" Background="Transparent" BorderThickness="0" ToolTip.Tip="Preview PDF"><TextBlock loc:UiLocalization.Text="picture_as_pdf" Classes="action-icon-glyph" Foreground="#6E6E6E" /></Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="QuickActionsTemplate">
        <Border Padding="14.4" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000">
          <StackPanel Spacing="11.2">
            <TextBlock loc:UiLocalization.Text="Quick Actions" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
            <ItemsControl ItemsSource="{Binding QuickActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding Command}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" MinHeight="33.6">
                    <Grid ColumnDefinitions="42,*,Auto">
                      <Border Width="28" Height="22.4" CornerRadius="8" Background="{Binding IconBackground}" VerticalAlignment="Center"><TextBlock Text="{Binding Icon}" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="15" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                      <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="{DynamicResource DashboardMuted}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="OutOfStockTemplate">
        <Border Padding="14.4" CornerRadius="12" Background="{DynamicResource DashboardCard}" BorderBrush="#FFCDD2" BorderThickness="1" BoxShadow="0 8 22 0 #10000000">
          <StackPanel Spacing="11.2">
            <Grid ColumnDefinitions="34,*,Auto">
              <Border Width="28" Height="22.4" CornerRadius="8" Background="{DynamicResource AppCardBrush}"><TextBlock loc:UiLocalization.Text="inventory_2" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="15" Foreground="#F44336" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" loc:UiLocalization.Text="Out of Stock" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
              <Border Grid.Column="2" Width="22" Height="17.6" CornerRadius="11" Background="{DynamicResource AppCardBrush}"><TextBlock Text="{Binding OutOfStockCount}" FontSize="11" Foreground="#F44336" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding OutOfStockProducts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,3">
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StockLeft}" FontSize="12" Foreground="#F44336" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Classes="action outline" Command="{Binding RestockCommand}" ToolTip.Tip="Restock" Background="#E8F5E9" Foreground="#2E7D32" BorderThickness="0">
                      <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="add_box" Classes="action-icon-glyph" /><TextBlock loc:UiLocalization.Text="Stock" FontSize="11" /></StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock loc:UiLocalization.Text="No products are out of stock" IsVisible="{Binding HasNoOutOfStock}" FontSize="12" Foreground="{DynamicResource DashboardMuted}" />
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="TopCustomersTemplate">
        <Border Padding="14.4" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000">
          <StackPanel Spacing="11.2">
            <Grid ColumnDefinitions="34,*"><Border Width="28" Height="22.4" CornerRadius="8" Background="{DynamicResource AppCardBrush}"><TextBlock loc:UiLocalization.Text="emoji_events" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="14" Foreground="#1976D2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" loc:UiLocalization.Text="Top Customers" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" /></Grid>
            <ItemsControl ItemsSource="{Binding TopCustomers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="34,*,Auto" MinHeight="25.6">
                    <Border Width="24" Height="19.2" CornerRadius="12" Background="{DynamicResource AppCardBrush}"><TextBlock Text="{Binding Initial}" FontSize="11" Foreground="#083B88" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="TopProductsTemplate">
        <Border Padding="14.4" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000">
          <StackPanel Spacing="11.2">
            <Grid ColumnDefinitions="34,*"><Border Width="28" Height="22.4" CornerRadius="8" Background="{DynamicResource AppCardBrush}"><TextBlock loc:UiLocalization.Text="trending_up" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="14" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" loc:UiLocalization.Text="Top Products" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" /></Grid>
            <ItemsControl ItemsSource="{Binding TopProducts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="34,*,Auto" MinHeight="25.6">
                    <Border Width="24" Height="19.2" CornerRadius="7" Background="{DynamicResource AppCardBrush}"><TextBlock loc:UiLocalization.Text="inventory_2" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="12" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Reference dimensions apply only to Default; alternative layouts retain the shared shell sizes. -->
    <Style Selector="TextBlock#DashboardTitle"><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="StackPanel#DashboardContent"><Setter Property="Margin" Value="12.8"/></Style>
    <Style Selector="Border#DashboardHeader.default"><Setter Property="Height" Value="56"/><Setter Property="MinHeight" Value="56"/></Style>
    <Style Selector="Border#DashboardHeader.default TextBlock#DashboardTitle"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Normal"/></Style>
    <Style Selector="StackPanel#DashboardContent.default"><Setter Property="Margin" Value="28"/></Style>
    <Style Selector="StackPanel#DashboardContent.default.compact"><Setter Property="Margin" Value="16"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border x:Name="DashboardHeader" Classes="page-header" Classes.default="{Binding IsDefaultLayout}">
      <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="30.4">
        <TextBlock x:Name="DashboardTitle" Grid.ColumnSpan="3" loc:UiLocalization.Text="Dashboard Overview" Foreground="White" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6.4">
          <Button ToolTip.Tip="Dashboard layout" Classes="action-icon header-icon-action">
            <TextBlock loc:UiLocalization.Text="dashboard_customize" Classes="action-icon-glyph" Foreground="White" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Tag="Default" Command="{Binding SelectLayoutCommand}" CommandParameter="Default">
                  <MenuItem.Header>
                    <Grid ColumnDefinitions="22,*,24" Width="170" Margin="2,4">
                      <TextBlock loc:UiLocalization.Text="view_agenda" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="16" Foreground="#6E6E6E" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="0.8">
                        <TextBlock loc:UiLocalization.Text="Default" FontSize="13" Foreground="#1F1F29" />
                        <TextBlock loc:UiLocalization.Text="Original layout" FontSize="11" Foreground="#6E6E78" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="✓" FontSize="16" Foreground="#083B88" IsVisible="{Binding IsDefaultLayout}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="Classic" Command="{Binding SelectLayoutCommand}" CommandParameter="Classic">
                  <MenuItem.Header>
                    <Grid ColumnDefinitions="22,*,24" Width="170" Margin="2,4">
                      <TextBlock loc:UiLocalization.Text="dashboard" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="16" Foreground="#083B88" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="0.8">
                        <TextBlock loc:UiLocalization.Text="Classic" FontSize="13" FontWeight="Bold" Foreground="#083B88" />
                        <TextBlock loc:UiLocalization.Text="Charts + KPI grid" FontSize="11" Foreground="#6E6E78" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="✓" FontSize="16" Foreground="#083B88" IsVisible="{Binding IsClassicLayout}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="Bento" Command="{Binding SelectLayoutCommand}" CommandParameter="Bento">
                  <MenuItem.Header>
                    <Grid ColumnDefinitions="22,*,24" Width="170" Margin="2,4">
                      <TextBlock loc:UiLocalization.Text="dashboard_customize" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="16" Foreground="#6E6E6E" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="0.8">
                        <TextBlock loc:UiLocalization.Text="Bento" FontSize="13" FontWeight="Bold" Foreground="#083B88" />
                        <TextBlock loc:UiLocalization.Text="Hero chart + card grid" FontSize="11" Foreground="#6E6E78" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="✓" FontSize="16" Foreground="#083B88" IsVisible="{Binding IsBentoLayout}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </MenuItem.Header>
                </MenuItem>
                <MenuItem Tag="Simple" Command="{Binding SelectLayoutCommand}" CommandParameter="Simple">
                  <MenuItem.Header>
                    <Grid ColumnDefinitions="22,*,24" Width="170" Margin="2,4">
                      <TextBlock loc:UiLocalization.Text="view_list" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="16" Foreground="#6E6E6E" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="0.8">
                        <TextBlock loc:UiLocalization.Text="Simple" FontSize="13" Foreground="#1F1F29" />
                        <TextBlock loc:UiLocalization.Text="Clean list view" FontSize="11" Foreground="#6E6E78" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="✓" FontSize="16" Foreground="#083B88" IsVisible="{Binding IsSimpleFeedLayout}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                  </MenuItem.Header>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Tag="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh" Classes="action-icon header-icon-action">
            <TextBlock loc:UiLocalization.Text="refresh" Classes="action-icon-glyph" Foreground="White" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource DashboardSurface}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DashboardContent" Classes.default="{Binding IsDefaultLayout}" Classes.compact="{Binding IsCompact}" Spacing="16" HorizontalAlignment="Stretch">
          <Border IsVisible="{Binding ShowHero}" CornerRadius="16" Padding="22.4,19.2" MinHeight="83.2" BoxShadow="0 8 22 0 #16000000">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1E293B" Offset="0" />
                <GradientStop Color="#334155" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel Spacing="4.8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock loc:UiLocalization.Text="Welcome back," FontSize="22" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="{Binding Username}" FontSize="22" FontWeight="Bold" Foreground="White" />
              </StackPanel>
              <TextBlock loc:UiLocalization.Text="Here's your business at a glance" FontSize="13" Foreground="#D6E3F3" />
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Tiles}" IsVisible="{Binding ShowKpiRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="204" MinHeight="62.4" Margin="0,0,10,12" Padding="14.4" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000">
                  <Grid ColumnDefinitions="42,14,*">
                    <Border Width="37" Height="29.6" CornerRadius="9" Background="{Binding IconBackground}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Icon}" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="18" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource DashboardMuted}" />
                      <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="3*,16,2*" IsVisible="{Binding ShowChartGrid}">
            <Border Padding="17.6" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000" MinHeight="282">
              <StackPanel Spacing="14.4">
                <TextBlock loc:UiLocalization.Text="Revenue — Last 6 Months" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
                <Grid Height="210" RowDefinitions="*,Auto">
                  <Grid RowDefinitions="*,*,*,*" ClipToBounds="True">
                    <Border BorderBrush="#E9E9EF" BorderThickness="0,0,0,1" />
                    <Border Grid.Row="1" BorderBrush="#E9E9EF" BorderThickness="0,0,0,1" />
                    <Border Grid.Row="2" BorderBrush="#E9E9EF" BorderThickness="0,0,0,1" />
                    <Rectangle Grid.RowSpan="4" Width="28" Height="136" RadiusX="7" RadiusY="7" Fill="#0B4A9A" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                  </Grid>
                  <TextBlock Grid.Row="1" loc:UiLocalization.Text="Sep" FontSize="11" Foreground="{DynamicResource DashboardMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="17.6" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000" MinHeight="282">
              <StackPanel Spacing="8">
                <TextBlock loc:UiLocalization.Text="Financial Overview" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
                <Grid Height="176">
                  <Ellipse Width="152" Height="152" Stroke="#2E7D32" StrokeThickness="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Rectangle Width="42" Height="6" Fill="#D32F2F" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,56,0" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="6.4"><Ellipse Width="10" Height="10" Fill="#2E7D32" /><TextBlock loc:UiLocalization.Text="Collected" FontSize="12" Foreground="{DynamicResource DashboardMuted}" /></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding CollectedText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6.4"><Ellipse Width="10" Height="10" Fill="#D32F2F" /><TextBlock loc:UiLocalization.Text="Outstanding" FontSize="12" Foreground="{DynamicResource DashboardMuted}" /></StackPanel>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutstandingText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="3*,16,2*" IsVisible="{Binding ShowBentoGrid}">
            <StackPanel Spacing="11.2">
              <Border Padding="17.6" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000" MinHeight="282">
                <StackPanel Spacing="14.4">
                  <TextBlock loc:UiLocalization.Text="Revenue — Last 6 Months" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" />
                  <Grid Height="210" RowDefinitions="*,Auto">
                    <Grid RowDefinitions="*,*,*,*" ClipToBounds="True">
                      <Border BorderBrush="#E9E9EF" BorderThickness="0,0,0,1" />
                      <Border Grid.Row="1" BorderBrush="#E9E9EF" BorderThickness="0,0,0,1" />
                      <Border Grid.Row="2" BorderBrush="#E9E9EF" BorderThickness="0,0,0,1" />
                      <Rectangle Grid.RowSpan="4" Width="28" Height="136" RadiusX="7" RadiusY="7" Fill="#0B4A9A" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="1" loc:UiLocalization.Text="Sep" FontSize="11" Foreground="{DynamicResource DashboardMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RecentInvoiceTableTemplate}" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TopProductsTemplate}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="11.2">
              <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="210" MinHeight="62.4" Margin="0,0,12,12" Padding="14.4" CornerRadius="12" Background="{DynamicResource DashboardCard}" BoxShadow="0 8 22 0 #10000000">
                      <Grid ColumnDefinitions="42,10,*">
                        <Border Width="37" Height="29.6" CornerRadius="9" Background="{Binding IconBackground}" VerticalAlignment="Center"><TextBlock Text="{Binding Icon}" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="17" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource DashboardMuted}" /><TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DashboardText}" /></StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource QuickActionsTemplate}" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OutOfStockTemplate}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="3*,16,2*" IsVisible="{Binding ShowClassicLowerGrid}">
            <StackPanel Spacing="11.2">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RecentInvoiceTableTemplate}" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TopProductsTemplate}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="11.2">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OutOfStockTemplate}" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource QuickActionsTemplate}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="3*,16,2*" IsVisible="{Binding ShowSimpleFeedGrid}">
            <StackPanel Spacing="11.2">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RecentInvoiceTableTemplate}" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TopCustomersTemplate}" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TopProductsTemplate}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="11.2">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource QuickActionsTemplate}" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OutOfStockTemplate}" />
            </StackPanel>
          </Grid>

          <views:DashboardDefaultView IsVisible="{Binding ShowDefaultFeed}"/>

          <TextBlock loc:UiLocalization.Text="No invoices yet" IsVisible="{Binding HasNoInvoices}" Foreground="{DynamicResource DashboardMuted}" HorizontalAlignment="Center" FontSize="14" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
