<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.SettingsWorkspaceView">
  <Grid x:Name="WorkspaceGrid" ColumnDefinitions="240,*">
    <ContentControl x:Name="RailHost" />
    <ContentControl x:Name="ContentHost" Grid.Column="1" />
  </Grid>
</UserControl>
