<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.ManagementView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ManagementSurface">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="ManagementCardSurface">#F7FAFC</SolidColorBrush>
          <SolidColorBrush x:Key="ManagementOutline">#E0E0E0</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ManagementSurface">#18212B</SolidColorBrush>
          <SolidColorBrush x:Key="ManagementCardSurface">#202B36</SolidColorBrush>
          <SolidColorBrush x:Key="ManagementOutline">#526171</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid x:Name="RecordRoot" RowDefinitions="Auto,*">
      <ContentControl x:Name="HeaderHost" />
      <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Border Padding="12.8">
        <StackPanel Spacing="9.6">
          <ContentControl x:Name="ProductBannerHost" />

          <ContentControl x:Name="StatsHost" />
          <ContentControl x:Name="ToolbarHost" />
          <ContentControl x:Name="RecordResultsHost" />
        </StackPanel>
      </Border>
      </ScrollViewer>
    </Grid>
    <Grid x:Name="DocumentRoot"
          IsVisible="False"
          RowDefinitions="Auto,*">
      <ContentControl x:Name="DocumentAppBarHost" />
      <Border Grid.Row="1"
              Background="{DynamicResource ManagementSurface}">
        <Grid RowDefinitions="Auto,*">
          <Border Padding="16,17.6,16,14.4">
            <Grid ColumnDefinitions="Auto,12,280,12,Auto,*,Auto">
              <ContentControl x:Name="DocumentAddHost" />
              <ContentControl x:Name="DocumentSearchHost" Grid.Column="2" />
              <ContentControl x:Name="DocumentToolbarHost" Grid.Column="4" />
              <ContentControl x:Name="DocumentPageSummaryHost" Grid.Column="6" />
            </Grid>
          </Border>
          <ContentControl x:Name="DocumentResultsHost" Grid.Row="1" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
