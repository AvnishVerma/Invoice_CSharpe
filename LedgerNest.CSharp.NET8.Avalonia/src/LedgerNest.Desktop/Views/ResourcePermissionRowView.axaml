<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop"
             xmlns:local="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.ResourcePermissionRowView"
             x:DataType="vm:PermissionResourceRowViewModel">
  <Border Padding="16,10" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="*,90,90,90,90">
      <TextBlock Text="{Binding Resource}" FontWeight="SemiBold" VerticalAlignment="Center" />
      <local:PermissionToggleView Grid.Column="1" DataContext="{Binding View}" />
      <local:PermissionToggleView Grid.Column="2" DataContext="{Binding Add}" />
      <local:PermissionToggleView Grid.Column="3" DataContext="{Binding Update}" />
      <local:PermissionToggleView Grid.Column="4" DataContext="{Binding Delete}" />
    </Grid>
  </Border>
</UserControl>
