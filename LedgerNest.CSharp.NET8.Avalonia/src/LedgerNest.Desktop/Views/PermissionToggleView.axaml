<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop"
             x:Class="LedgerNest.Desktop.Views.PermissionToggleView"
             x:DataType="vm:PermissionRowViewModel">
  <Grid Width="76" HorizontalAlignment="Center">
    <ToggleSwitch HorizontalAlignment="Center"
                  IsVisible="{Binding IsSupported}"
                  IsChecked="{Binding IsAllowed}"
                  IsEnabled="{Binding CanToggle}"
                  ToolTip.Tip="{Binding Description}" />
    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding !IsSupported}" Foreground="{DynamicResource AppMutedBrush}"
               ToolTip.Tip="Not available for this resource" />
  </Grid>
</UserControl>
