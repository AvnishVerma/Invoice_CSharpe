<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" xmlns:local="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.PermissionManagementView" x:DataType="vm:PermissionManagementViewModel">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
    <local:PageHeaderView Title="User Permissions" />
    <Grid Grid.Row="1" Margin="{DynamicResource PageContentPadding}" ColumnDefinitions="280,16,*" MinWidth="760">
      <Border Classes="settings-column">
        <StackPanel Spacing="12">
        <Grid RowDefinitions="Auto,6,Auto,12,Auto">
          <TextBlock Text="PERMISSIONS FOR ROLE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}"/>
          <ComboBox Grid.Row="2" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"/>
          <StackPanel Grid.Row="4" Spacing="8"><TextBox Text="{Binding NewRoleName}" PlaceholderText="New role name, for example Cashier"/><Button Content="Create Role" Command="{Binding CreateRoleCommand}" Classes="action outline" HorizontalAlignment="Stretch"/><Button Content="Delete Selected Role" Command="{Binding DeleteRoleCommand}" Classes="action outline" HorizontalAlignment="Stretch"/></StackPanel>
        </Grid>
        <Border Padding="12" CornerRadius="10" Background="{DynamicResource AppSelectedBrush}"><StackPanel Spacing="6"><TextBlock Text="Role-based access" FontWeight="SemiBold"/><TextBlock Text="Changes affect every user assigned to the selected role. Assign roles from User Management. Administrators remain unrestricted." Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
        <StackPanel><TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="#2E7D32" TextWrapping="Wrap"/></StackPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Column="2" RowDefinitions="*,Auto">
      <Border Classes="settings-column" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,90,90,90,90" Margin="16,10"><TextBlock Text="RESOURCE"/><TextBlock Grid.Column="1" Text="VIEW" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="ADD" HorizontalAlignment="Center"/><TextBlock Grid.Column="3" Text="UPDATE" HorizontalAlignment="Center"/><TextBlock Grid.Column="4" Text="DELETE" HorizontalAlignment="Center"/></Grid>
          <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding ResourcePermissions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PermissionResourceRowViewModel">
            <local:ResourcePermissionRowView />
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
      </Border>
      <Button Grid.Row="1" Content="Save Permissions" Command="{Binding SaveCommand}" Classes="action primary" IsEnabled="{Binding CanManage}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
