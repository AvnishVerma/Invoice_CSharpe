<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" x:Class="LedgerNest.Desktop.Views.PermissionManagementView" x:DataType="vm:PermissionManagementViewModel">
  <Grid RowDefinitions="68,*" Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource PageHeaderBrush}" Padding="20,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="User Permissions" FontSize="20" Foreground="White"/><TextBlock Text="Map each user to a role and configure what that role can do" FontSize="11" Foreground="#DCE8FA"/></StackPanel></Border>
    <Grid Grid.Row="1" RowDefinitions="Auto,12,Auto,12,*,Auto" Margin="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <Border Padding="16" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="*,16,260" RowDefinitions="Auto,6,Auto">
          <TextBlock Text="USER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}"/>
          <TextBlock Grid.Column="2" Text="ASSIGNED ROLE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}"/>
          <ComboBox Grid.Row="2" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PermissionUserViewModel"><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"/>
        </Grid>
      </Border>
      <Border Grid.Row="2" Padding="14" CornerRadius="10" Background="{DynamicResource AppSelectedBrush}"><Grid ColumnDefinitions="Auto,12,*"><TextBlock Text="admin_panel_settings" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="22" Foreground="{DynamicResource AppAccentBrush}"/><StackPanel Grid.Column="2"><TextBlock Text="Role-based access" FontWeight="SemiBold"/><TextBlock Text="The selected user inherits these permissions from the assigned role. Changes affect every user with that role. Administrators remain unrestricted." Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
      <Border Grid.Row="4" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="180,130,*,100" Margin="16,10"><TextBlock Text="RESOURCE"/><TextBlock Grid.Column="1" Text="ACTION"/><TextBlock Grid.Column="2" Text="DESCRIPTION"/><TextBlock Grid.Column="3" Text="ALLOW"/></Grid>
          <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding Permissions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PermissionRowViewModel">
            <Border Padding="16,11" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="180,130,*,100"><TextBlock Text="{Binding Resource}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Action}"/><TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{DynamicResource AppMutedBrush}"/><ToggleSwitch Grid.Column="3" IsChecked="{Binding IsAllowed}"/></Grid></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
      </Border>
      <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding Error}" Foreground="#C62828"/><TextBlock Text="{Binding Status}" Foreground="#2E7D32"/></StackPanel><Button Grid.Column="1" Content="Save User Mapping &amp; Permissions" Command="{Binding SaveCommand}" Classes="primary" IsEnabled="{Binding CanManage}"/></Grid>
    </Grid>
  </Grid>
</UserControl>
