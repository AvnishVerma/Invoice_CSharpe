<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" xmlns:local="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.PermissionManagementView" x:DataType="vm:PermissionManagementViewModel">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
    <local:PageHeaderView Title="User Permissions" />
    <Grid Grid.Row="1" RowDefinitions="Auto,12,Auto,12,*,Auto" Margin="{DynamicResource PageContentPadding}" MaxWidth="1100" HorizontalAlignment="Stretch">
      <Border Padding="16" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="260,16,*" RowDefinitions="Auto,6,Auto,12,Auto">
          <TextBlock Text="PERMISSIONS FOR ROLE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}"/>
          <ComboBox Grid.Row="2" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"/>
          <Grid Grid.Row="4" Grid.ColumnSpan="3" ColumnDefinitions="*,10,Auto,8,Auto"><TextBox Text="{Binding NewRoleName}" PlaceholderText="New role name, for example Cashier"/><Button Grid.Column="2" Content="Create Role" Command="{Binding CreateRoleCommand}" Classes="action outline"/><Button Grid.Column="4" Content="Delete Selected Role" Command="{Binding DeleteRoleCommand}" Classes="action outline"/></Grid>
        </Grid>
      </Border>
      <Border Grid.Row="2" Padding="14" CornerRadius="10" Background="{DynamicResource AppSelectedBrush}"><Grid ColumnDefinitions="Auto,12,*"><TextBlock Text="admin_panel_settings" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="22" Foreground="{DynamicResource AppAccentBrush}"/><StackPanel Grid.Column="2"><TextBlock Text="Role-based access" FontWeight="SemiBold"/><TextBlock Text="Changes affect every user assigned to the selected role. Assign roles from User Management. Administrators remain unrestricted." Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
      <Border Grid.Row="4" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,90,90,90,90" Margin="16,10"><TextBlock Text="RESOURCE"/><TextBlock Grid.Column="1" Text="VIEW" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="ADD" HorizontalAlignment="Center"/><TextBlock Grid.Column="3" Text="UPDATE" HorizontalAlignment="Center"/><TextBlock Grid.Column="4" Text="DELETE" HorizontalAlignment="Center"/></Grid>
          <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding ResourcePermissions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PermissionResourceRowViewModel">
            <local:ResourcePermissionRowView />
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
      </Border>
      <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding Error}" Foreground="#C62828"/><TextBlock Text="{Binding Status}" Foreground="#2E7D32"/></StackPanel><Button Grid.Column="1" Content="Save Permissions" Command="{Binding SaveCommand}" Classes="action primary" IsEnabled="{Binding CanManage}"/></Grid>
    </Grid>
  </Grid>
</UserControl>
