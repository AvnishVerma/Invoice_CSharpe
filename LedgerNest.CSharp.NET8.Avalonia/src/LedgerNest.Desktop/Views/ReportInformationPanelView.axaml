<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" x:Class="LedgerNest.Desktop.Views.ReportInformationPanelView" x:DataType="vm:ReportInformationModel">
  <Border Padding="20" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
    <StackPanel Spacing="10">
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Details}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
