<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.PdfTemplateSelectorView">
  <UserControl.Styles>
    <Style Selector="ContentControl#TemplatesHost Button.action">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinHeight" Value="88" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ContentControl#TemplatesHost Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Padding="12" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,*">
      <StackPanel Spacing="6">
        <TextBlock Text="PAGE SIZE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
        <ContentControl x:Name="PageSizeHost" />
      </StackPanel>
      <Border Grid.Row="1" Padding="0,13,0,8">
        <TextBlock Text="TEMPLATES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
      </Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="TemplatesHost" />
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
