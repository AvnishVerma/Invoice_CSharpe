<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" x:Class="LedgerNest.Desktop.Views.FontAwesomeIconLabelView" x:DataType="vm:FontAwesomeIconLabelModel">
  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Name, Converter={StaticResource FontAwesomeGlyphConverter}}" FontFamily="{DynamicResource IconFontFamily}" FontSize="{Binding Size}" Foreground="{Binding Color}" VerticalAlignment="Center"/><TextBlock Text="{Binding Caption}" FontSize="{Binding Size}" Foreground="{Binding Color}" VerticalAlignment="Center"/></StackPanel>
</UserControl>
