<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" xmlns:views="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.MasterCodeSettingsView" x:DataType="vm:MasterCodeSettingsViewModel">
  <StackPanel Spacing="12">
    <TextBlock Text="CUSTOMER &amp; PRODUCT CODES" Classes="section-label"/>
    <ItemsControl ItemsSource="{Binding Configurations}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CodeConfigurationViewModel">
          <Border Classes="card" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock Text="Prefix"/>
              <TextBox Text="{Binding Prefix, Mode=TwoWay}" MaxLength="50" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} Prefix'}"/>
              <WrapPanel Orientation="Horizontal">
                <StackPanel Spacing="4" Margin="0,0,16,8">
                  <TextBlock Text="Next Number"/>
                  <NumericUpDown Value="{Binding NextNumber, Mode=TwoWay}" Minimum="1" Maximum="9223372036854775806" Increment="1" FormatString="0" Width="200" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} Next Number'}"/>
                </StackPanel>
                <StackPanel Spacing="4" Margin="0,0,0,8">
                  <TextBlock Text="Leading Zeros"/>
                  <NumericUpDown Value="{Binding LeadingZeros, Mode=TwoWay}" Minimum="0" Maximum="18" Increment="1" FormatString="0" Width="140" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} Leading Zeros'}"/>
                </StackPanel>
              </WrapPanel>
              <ToggleSwitch IsChecked="{Binding AutoGenerate, Mode=TwoWay}" Content="Auto-generate" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} Auto-generate'}"/>
              <TextBlock Text="{Binding Preview}" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="Blank codes generate automatically when enabled. Existing codes stay unchanged; an explicitly entered code is preserved." Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>
    <views:ActionButtonView ActionLabel="Save Code Settings" Caption="Save Code Settings" Icon="save" Tooltip="Save Code Settings" Command="{Binding SaveCommand}" Available="{Binding CanSave}"/>
  </StackPanel>
</UserControl>
