<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" xmlns:views="using:LedgerNest.Desktop.Views" xmlns:primitives="using:Avalonia.Controls.Primitives"
             x:Class="LedgerNest.Desktop.Views.ReportTableView" x:DataType="vm:ReportTableViewModel">
  <UserControl.Styles>
    <Style Selector="Border#Card"><Setter Property="Padding" Value="20" /><Setter Property="Background" Value="{DynamicResource AppCardBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border#Card.unwrapped"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Border.row"><Setter Property="Background" Value="{DynamicResource AppCardBrush}" /><Setter Property="Padding" Value="14" /></Style>
    <Style Selector="Border.row.even"><Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" /></Style>
    <Style Selector="Border.row.header"><Setter Property="Padding" Value="14,10" /></Style>
    <Style Selector="TextBlock.cell"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" /></Style>
    <Style Selector="TextBlock.cell.first"><Setter Property="FontWeight" Value="Bold" /></Style>
    <Style Selector="TextBlock.cell.money"><Setter Property="Foreground" Value="#16A34A" /></Style>
    <Style Selector="TextBlock.cell.danger"><Setter Property="Foreground" Value="#EF4444" /></Style>
    <Style Selector="TextBlock.cell.header"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" /></Style>
  </UserControl.Styles>
  <Border x:Name="Card" Classes.unwrapped="{Binding !WrapInCard}" CornerRadius="12" BorderBrush="{DynamicResource AppOutlineBrush}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <WrapPanel Grid.Column="1" IsVisible="{Binding HasTitle}">
          <Button Command="{Binding ExportCsvCommand}" Classes="action outline" ToolTip.Tip="Export CSV" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="download" Classes="action-icon-glyph" /><TextBlock Text="Export CSV" /></StackPanel></Button>
          <Button Command="{Binding ExportPdfCommand}" Classes="action outline" ToolTip.Tip="Export PDF" Margin="0,0,8,8"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="download" Classes="action-icon-glyph" /><TextBlock Text="Export PDF" /></StackPanel></Button>
        </WrapPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
        <StackPanel>
          <Border IsVisible="{Binding HasNoRows}"><views:EmptyStateView DataContext="{Binding EmptyState}" /></Border>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReportRowModel">
                <Border Classes="row" Classes.even="{Binding IsEven}" Classes.header="{Binding IsHeader}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1">
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ReportCellModel"><TextBlock Text="{Binding Text}" Classes="cell" Classes.header="{Binding IsHeader}" Classes.first="{Binding IsFirst}" Classes.money="{Binding IsMoney}" Classes.danger="{Binding IsDanger}" VerticalAlignment="Center" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><TextBlock Text="Rows per page: 10      1 – 1 of 1" FontSize="13" /><TextBlock Grid.Column="1" Text="‹   Page 1 of 1   ›" FontSize="13" FontWeight="Bold" /></Grid>
    </Grid>
  </Border>
</UserControl>
