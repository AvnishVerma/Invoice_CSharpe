<UserControl xmlns:icons="using:LedgerNest.Desktop" xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.CustomerViewDialog"
             x:CompileBindings="False">
  <StackPanel Spacing="11.2">

    <ItemsControl ItemsSource="{Binding Fields}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="12,0,0,6" />
            <Border CornerRadius="8" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" Background="{DynamicResource AppCanvasBrush}" MinHeight="{DynamicResource TextInputHeight}" Padding="{DynamicResource TextInputPadding}">
              <Grid ColumnDefinitions="28,*">
                <TextBlock Text="{Binding Icon, Converter={StaticResource FontAwesomeGlyphConverter}}" FontFamily="{DynamicResource IconFontFamily}" FontSize="18" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="15" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
