<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="LedgerNest.Desktop.Views.ProductItemDialogView"
             x:DataType="vm:ProductItemDialogViewModel"
             KeyDown="OnKeyDown">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DialogSurface">#EDE7F1</SolidColorBrush>
          <SolidColorBrush x:Key="DialogInput">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="DialogMuted">#666666</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DialogSurface">#302A38</SolidColorBrush>
          <SolidColorBrush x:Key="DialogInput">#25212B</SolidColorBrush>
          <SolidColorBrush x:Key="DialogMuted">#BDB6C6</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Background" Value="{DynamicResource DialogInput}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource DialogInput}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource DialogMuted}" />
    </Style>
    <Style Selector="TextBlock.helper">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource DialogMuted}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="Firebrick" />
    </Style>
    <Style Selector="Border.label">
      <Setter Property="Background" Value="{DynamicResource DialogSurface}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="9,-7,0,0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Grid Background="#88000000">
    <Grid x:Name="DialogArea" Margin="16">
      <Border Width="624" MaxWidth="{Binding #DialogArea.Bounds.Width}"
              MaxHeight="{Binding #DialogArea.Bounds.Height}"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="24" CornerRadius="16" Background="{DynamicResource DialogSurface}"
              KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="Auto,12,*" Margin="0,0,0,16">
            <TextBlock Text="&#xE8CC;" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                       FontSize="28" Foreground="#003580" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="18" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <Border Background="#E7F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <TextBlock Text="{Binding StockText}" FontSize="13" Foreground="#388E3C" />
              </Border>
              <StackPanel Spacing="4">
                <Grid>
                  <TextBox x:Name="QuantityInput" Watermark="Quantity" Text="{Binding Quantity.Value, Mode=TwoWay}" AutomationProperties.Name="Quantity" />
                  <Border Classes="label"><TextBlock Classes="caption" Text="Quantity" /></Border>
                </Grid>
                <TextBlock Classes="error" Text="{Binding Quantity.Error}"
                           IsVisible="{Binding Quantity.Error, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Grid>
                <ComboBox ItemsSource="{Binding Unit.Options}" SelectedItem="{Binding Unit.Value, Mode=TwoWay}" AutomationProperties.Name="Unit (override)" />
                <Border Classes="label"><TextBlock Classes="caption" Text="Unit (override)" /></Border>
              </Grid>
              <StackPanel Spacing="4">
                <Grid>
                  <TextBox Watermark="Discount" Text="{Binding Discount.Value, Mode=TwoWay}" AutomationProperties.Name="Discount" />
                  <Border Classes="label"><TextBlock Classes="caption" Text="Discount" /></Border>
                </Grid>
                <TextBlock Classes="error" Text="{Binding Discount.Error}"
                           IsVisible="{Binding Discount.Error, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="Discount per unit" FontSize="13" />
                  <TextBlock Classes="helper" Text="(price − discount) × qty" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscountPerUnit, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="Discount per unit" />
              </Grid>
              <StackPanel Spacing="4">
                <Grid>
                  <TextBox Watermark="Unit Price (override)" Text="{Binding Price.Value, Mode=TwoWay}" AutomationProperties.Name="Unit Price (override)" />
                  <Border Classes="label"><TextBlock Classes="caption" Text="Unit Price (override)" /></Border>
                </Grid>
                <TextBlock Classes="error" Text="{Binding Price.Error}"
                           IsVisible="{Binding Price.Error, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <TextBlock Classes="helper" Text="{Binding DefaultPriceText}" />
              <StackPanel Spacing="4">
                <Grid>
                  <TextBox Watermark="Extra Cost (optional)" Text="{Binding ExtraCost.Value, Mode=TwoWay}" AutomationProperties.Name="Extra Cost (optional)" />
                  <Border Classes="label"><TextBlock Classes="caption" Text="Extra Cost (optional)" /></Border>
                </Grid>
                <TextBlock Classes="error" Text="{Binding ExtraCost.Error}"
                           IsVisible="{Binding ExtraCost.Error, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <TextBlock Classes="helper" Text="Flat fee added on top of the line total" />
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Add" Command="{Binding AddCommand}" Classes="primary" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
