<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" xmlns:local="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.InvoiceDocumentDetailsPanelView" x:DataType="vm:InvoiceDocumentDetailsViewModel" Container.Name="invoice-details" Container.Sizing="Width">
  <UserControl.Styles>
    <Style Selector="UniformGrid.date-time-fields"><Setter Property="Columns" Value="2"/></Style>
    <ContainerQuery Name="invoice-details" Query="max-width:420"><Style Selector="UniformGrid.date-time-fields"><Setter Property="Columns" Value="1"/></Style></ContainerQuery>
  </UserControl.Styles>
  <Border Padding="16" CornerRadius="16" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
    <Expander x:Name="InvoiceDetailsExpander" AutomationProperties.Name="Invoice details" HorizontalAlignment="Stretch" IsExpanded="True">
      <Expander.Header><TextBlock vm:UiLocalization.Text="Invoice details" FontSize="16" FontWeight="SemiBold" /></Expander.Header>
      <StackPanel Spacing="10">
        <local:FormFieldView DataContext="{Binding TypeField}" />
        <UniformGrid Classes="date-time-fields"><local:FormFieldView DataContext="{Binding DateField}" Margin="0,0,8,8"/><local:FormFieldView DataContext="{Binding TimeField}" Margin="0,0,0,8"/></UniformGrid>
        <local:FormFieldView DataContext="{Binding DueDateField}" />
        <local:FormFieldView DataContext="{Binding TitleField}" />
        <local:FormFieldView DataContext="{Binding HideNumberField}" />
        <Expander Header="Bank account &amp; custom number" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <ComboBox ItemsSource="{Binding Workspace.InvoiceBankChoices}" SelectedItem="{Binding Workspace.SelectedInvoiceBank, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Invoice bank account">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:InvoiceBankChoice"><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <local:FormFieldView DataContext="{Binding CustomNumberField}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Expander>
  </Border>
</UserControl>
