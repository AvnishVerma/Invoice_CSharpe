<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.InvoiceDocumentDetailsPanelView">
  <Border Padding="10" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
    <StackPanel Spacing="13">
      <TextBlock Text="Document details" FontSize="16" FontWeight="SemiBold" />
      <ContentControl x:Name="DetailsHost" />
    </StackPanel>
  </Border>
</UserControl>
