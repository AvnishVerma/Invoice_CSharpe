<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.ProductRecordFormView">
  <StackPanel Spacing="16">
    <TextBlock loc:UiLocalization.Text="GENERAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
    <ContentControl x:Name="GeneralHost" />

    <TextBlock loc:UiLocalization.Text="PRICING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
    <ContentControl x:Name="PricingHost" />

    <TextBlock Text="STOCK &amp; UNIT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
    <ContentControl x:Name="StockHost" />

    <Expander Header="Advanced Information" HorizontalAlignment="Stretch">
      <ContentControl x:Name="AdvancedHost" />
    </Expander>
  </StackPanel>
</UserControl>
