<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop"
             xmlns:views="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.OverlayDialogView"
             x:DataType="vm:OverlayDialogViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="OverlayCardSurface">#F7FAFC</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayText">#000000</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayOutline">#E0E0E0</SolidColorBrush>
          <SolidColorBrush x:Key="ProminentSurface">#F2EDF5</SolidColorBrush>
          <SolidColorBrush x:Key="ProductSurface">#FFF8FF</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="OverlayCardSurface">#202B36</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayText">#F1F5F9</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayOutline">#526171</SolidColorBrush>
          <SolidColorBrush x:Key="ProminentSurface">#282330</SolidColorBrush>
          <SolidColorBrush x:Key="ProductSurface">#282330</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:RecordEditorFooterViewModel"><views:RecordDialogFooterView /></DataTemplate>
    <DataTemplate DataType="vm:UserDetailsViewModel"><views:UserDetailsView /></DataTemplate>
    <DataTemplate DataType="vm:UserEditorViewModel"><views:UserEditorView /></DataTemplate>
    <DataTemplate DataType="vm:UserPasswordViewModel"><views:UserPasswordView /></DataTemplate>
    <DataTemplate DataType="vm:FormFieldsViewModel"><views:FormFieldsView /></DataTemplate>
    <DataTemplate DataType="vm:DialogIcon" x:DataType="vm:DialogIcon"><TextBlock Text="{Binding Glyph}" Classes="action-icon-glyph" FontSize="22" Foreground="White" /></DataTemplate>
    <DataTemplate DataType="vm:AuthenticationFormViewModel"><views:AuthenticationFormView /></DataTemplate>
    <DataTemplate DataType="vm:OnboardingViewModel"><views:OnboardingStepView /></DataTemplate>
    <DataTemplate DataType="vm:KeyboardShortcutsViewModel"><views:KeyboardShortcutsView /></DataTemplate>
    <DataTemplate DataType="vm:ExpandedTextViewModel"><views:ExpandedTextView /></DataTemplate>
    <DataTemplate DataType="vm:OnboardingActions" x:DataType="vm:OnboardingActions">
      <WrapPanel>
        <Button Content="{Binding Model.BackLabel}" Command="{Binding Model.BackCommand}" Classes="action outline" Margin="0,0,8,0" />
        <Button Content="{Binding Model.ContinueLabel}" Command="{Binding Model.ContinueCommand}" Classes="action primary" />
      </WrapPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:DialogMessage" x:DataType="vm:DialogMessage">
      <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource OverlayText}" />
    </DataTemplate>
    <DataTemplate DataType="vm:DialogActions" x:DataType="vm:DialogActions">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DialogAction">
            <Button Content="{Binding Label}" Tag="{Binding Label}" Command="{Binding Command}"
                    Classes="action" Classes.primary="{Binding IsPrimary}" Classes.outline="{Binding !IsPrimary}"
                    Margin="0,0,8,0" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Styles>
    <Style Selector="Border#Panel"><Setter Property="CornerRadius" Value="12" /><Setter Property="Background" Value="{DynamicResource OverlayCardSurface}" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="TextBlock#TitleText"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Bold" /></Style>
    <Style Selector="ContentControl#FooterHost"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="Button#CloseButton"><Setter Property="MinWidth" Value="38" /></Style>
    <Style Selector="Border#Panel.side"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Stretch" /></Style>
    <Style Selector="Border#Panel.prominent"><Setter Property="CornerRadius" Value="28" /><Setter Property="Background" Value="{DynamicResource ProminentSurface}" /></Style>
    <Style Selector="TextBlock#TitleText.prominent"><Setter Property="FontSize" Value="24" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="Border#Panel.product"><Setter Property="Background" Value="{DynamicResource ProductSurface}" /></Style>
    <Style Selector="ContentControl#FooterHost.product"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="Button#CloseButton.product"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8" /><Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="FontSize" Value="22" /></Style>
  </UserControl.Styles>
  <Grid>
    <Border Background="#4D000000" PointerPressed="OnScrimPressed" />
    <Border x:Name="Panel" Margin="16" Padding="0" BorderThickness="1"
            BorderBrush="{DynamicResource OverlayOutline}"
            Width="{Binding PanelWidth}" MaxWidth="{Binding MaximumWidth}" MaxHeight="{Binding MaximumHeight}"

            Classes.side="{Binding IsSide}" Classes.prominent="{Binding IsProminent}" Classes.product="{Binding IsProductEditor}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="14.4,12.8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <ContentControl x:Name="LeadingIconHost" Content="{Binding LeadingIcon}" IsVisible="{Binding !IsProductEditor}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3.2">
              <TextBlock x:Name="TitleText" Text="{Binding Title}" Classes.prominent="{Binding IsProminent}"
                         Foreground="{DynamicResource OverlayText}" TextWrapping="Wrap" />
              <TextBlock IsVisible="{Binding IsProductEditor}" vm:UiLocalization.Text="Enter product details" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
            </StackPanel>
            <ContentControl Grid.Column="2" Content="{Binding HeaderAccessory}" VerticalAlignment="Center" />
            <Button x:Name="CloseButton" Grid.Column="3" Content="×" Classes="action outline" Classes.product="{Binding IsProductEditor}"
                    Command="{Binding CloseCommand}" IsVisible="{Binding ShowClose}" ToolTip.Tip="Close" AutomationProperties.Name="Close" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Border Padding="14.4"><ContentControl x:Name="BodyHost" Content="{Binding Body}" /></Border>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="14.4" BorderBrush="{DynamicResource OverlayOutline}" BorderThickness="0,1,0,0">
          <ContentControl x:Name="FooterHost" Content="{Binding Footer}" Classes.product="{Binding IsProductEditor}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
