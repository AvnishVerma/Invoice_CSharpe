<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.OverlayDialogView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="OverlayCardSurface">#F7FAFC</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayText">#000000</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayOutline">#E0E0E0</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="OverlayCardSurface">#202B36</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayText">#F1F5F9</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayOutline">#526171</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Border Background="#4D000000" PointerPressed="OnScrimPressed" />
    <Border x:Name="Panel"
            Margin="16"
            Padding="0"
            CornerRadius="12"
            BorderThickness="1"
            Background="{DynamicResource OverlayCardSurface}"
            BorderBrush="{DynamicResource OverlayOutline}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="14.4,12.8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <ContentControl x:Name="LeadingIconHost"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3.2">
            <TextBlock x:Name="TitleText"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource OverlayText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SubtitleText" IsVisible="False" loc:UiLocalization.Text="Enter product details" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
            </StackPanel>
            <ContentControl x:Name="HeaderAccessoryHost"
                            Grid.Column="2"
                            VerticalAlignment="Center" />
            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Content="×"
                    Classes="outline"
                    MinWidth="38"
                    Click="OnClosePressed" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <Border Padding="14.4">
            <ContentControl x:Name="BodyHost" />
          </Border>
        </ScrollViewer>
        <Border Grid.Row="2"
                Padding="14.4"
                BorderBrush="{DynamicResource OverlayOutline}"
                BorderThickness="0,1,0,0">
          <ContentControl x:Name="FooterHost" HorizontalAlignment="Right" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
