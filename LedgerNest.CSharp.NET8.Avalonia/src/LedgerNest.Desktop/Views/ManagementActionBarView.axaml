<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.ManagementActionBarView" x:Name="Root">
  <local:PageHeaderView Title="{Binding Title, ElementName=Root}" Actions="{Binding Actions, ElementName=Root}" />
</UserControl>
