<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.ManagementActionBarView">
  <Border Background="{DynamicResource PageHeaderBrush}" Height="44.8" Padding="20,0">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock x:Name="TitleText" Foreground="White" FontSize="20" VerticalAlignment="Center" />
      <StackPanel x:Name="ActionsHost" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
