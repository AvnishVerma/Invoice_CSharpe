<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.ProductReportView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Border.productReportCard">
      <Setter Property="Background" Value="#FBF5FF" />
      <Setter Property="BorderBrush" Value="#E4DEE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.exportButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#6B6B6B" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBlock.tableHeader">
      <Setter Property="Foreground" Value="#6B6B6B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.tableCell">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Classes="productReportCard" Margin="16">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" Margin="20,16,14,10">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Border Background="#F2EDF5" CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
              <TextBlock Text="▣  Rank: Revenue" FontSize="12" Foreground="#6B6B6B" />
            </Border>
            <Button Classes="exportButton" Command="{Binding ExportCsvCommand}" ToolTip.Tip="Export product report as CSV" Content="↓  Export CSV" />
            <Button Classes="exportButton" Command="{Binding ExportPdfCommand}" ToolTip.Tip="Export product report as PDF" Content="↓  Export PDF" />
          </StackPanel>
        </Grid>

        <Border IsVisible="{Binding HasMissingCosts}" Background="#FFFBEA" BorderBrush="#F4C84A" BorderThickness="1" CornerRadius="8" Margin="20,4,20,10" Padding="14,10">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="⚠" Foreground="#EA8A00" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding MissingCostMessage}" Foreground="#A85B13" FontSize="12" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding ChartRows}" Margin="20,4,20,14">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="160,*,120" Margin="0,5">
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Height="21" Minimum="0" Maximum="{Binding MaximumRevenue}" Value="{Binding RevenueValue}" Foreground="#7C3AED" Background="White" CornerRadius="4" />
                <TextBlock Grid.Column="2" Text="{Binding Revenue}" FontSize="13" FontWeight="SemiBold" Foreground="#7C3AED" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border IsVisible="{Binding HasNoRows}" Margin="20,4,20,16" Padding="14">
          <TextBlock Text="No product or service sales for this period." Foreground="#777777" HorizontalAlignment="Center" />
        </Border>

        <Border Background="White" BorderBrush="#E4DEE8" BorderThickness="0,1,0,1" Padding="20,9">
          <Grid ColumnDefinitions="48,2.4*,*,1.15*,1.25*,1.15*,.65*">
            <TextBlock Classes="tableHeader" Text="SL" />
            <TextBlock Grid.Column="1" Classes="tableHeader" Text="PRODUCT / SERVICE" />
            <TextBlock Grid.Column="2" Classes="tableHeader" Text="UNITS SOLD" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Classes="tableHeader" Text="REVENUE" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="tableHeader" Text="DISCOUNT GIVEN" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Classes="tableHeader" Text="PROFIT" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Classes="tableHeader" Text="MARGIN" HorizontalAlignment="Right" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#E4DEE8" BorderThickness="0,0,0,1" Padding="20,13">
                <Grid ColumnDefinitions="48,2.4*,*,1.15*,1.25*,1.15*,.65*">
                  <TextBlock Classes="tableCell" Text="{Binding Index}" Foreground="#777777" />
                  <TextBlock Grid.Column="1" Classes="tableCell" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="tableCell" Text="{Binding UnitsSold}" HorizontalAlignment="Right" Foreground="#777777" />
                  <TextBlock Grid.Column="3" Classes="tableCell" Text="{Binding Revenue}" HorizontalAlignment="Right" Foreground="#7C3AED" />
                  <TextBlock Grid.Column="4" Classes="tableCell" Text="{Binding DiscountGiven}" HorizontalAlignment="Right" Foreground="#777777" />
                  <TextBlock Grid.Column="5" Classes="tableCell" Text="{Binding Profit}" HorizontalAlignment="Right" Foreground="#16A34A" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="6" Classes="tableCell" Text="{Binding Margin}" HorizontalAlignment="Right" Foreground="#777777" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="*,Auto" Margin="20,13">
          <TextBlock Text="{Binding RangeText}" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="‹    Page 1 of 1    ›" FontSize="13" FontWeight="SemiBold" />
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
