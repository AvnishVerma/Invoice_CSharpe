<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.CustomerReportView"
             x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Border.customerReportCard">
      <Setter Property="Background" Value="#FBF5FF" />
      <Setter Property="BorderBrush" Value="#E4DEE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.reportTab">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.exportButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#6B6B6B" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBlock.tableHeader">
      <Setter Property="Foreground" Value="#6B6B6B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.tableCell">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="reportTab" IsVisible="{Binding IsOverview}" Content="✓  Overview" Background="#E8EDF9" BorderBrush="#0D47A1" Foreground="#0D47A1" FontWeight="SemiBold" />
        <Button Classes="reportTab" IsVisible="{Binding IsStatement}" Content="Overview" Command="{Binding ShowOverviewCommand}" Background="#FBF5FF" BorderBrush="#E4DEE8" Foreground="#666666" />
        <Button Classes="reportTab" IsVisible="{Binding IsOverview}" Content="Statements" Command="{Binding ShowStatementCommand}" Background="#FBF5FF" BorderBrush="#E4DEE8" Foreground="#666666" />
        <Button Classes="reportTab" IsVisible="{Binding IsStatement}" Content="✓  Statements" Background="#E8EDF9" BorderBrush="#0D47A1" Foreground="#0D47A1" FontWeight="SemiBold" />
      </StackPanel>

      <Border Classes="customerReportCard" IsVisible="{Binding IsOverview}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="20,16,14,12">
            <TextBlock Text="{Binding RevenueTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Classes="exportButton" Command="{Binding ExportCsvCommand}" ToolTip.Tip="Export customer report as CSV" Content="↓  Export CSV" />
              <Button Classes="exportButton" Command="{Binding ExportPdfCommand}" ToolTip.Tip="Export customer report as PDF" Content="↓  Export PDF" />
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding RevenueRows}" Margin="20,6,20,14">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="140,*,110" Margin="0,5">
                  <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Grid.Column="1" Height="21" Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Value}" Foreground="#3B82F6" Background="White" CornerRadius="4" />
                  <TextBlock Grid.Column="2" Text="{Binding Billed}" FontSize="13" FontWeight="SemiBold" Foreground="#0D47A1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border IsVisible="{Binding HasNoRevenueRows}" Margin="20,4,20,16" Padding="12">
            <TextBlock Text="No customer revenue for this period." Foreground="#777777" HorizontalAlignment="Center" />
          </Border>

          <Border Background="White" BorderBrush="#E4DEE8" BorderThickness="0,1,0,1" Padding="20,9">
            <Grid ColumnDefinitions="44,2*,*,*,*,*">
              <TextBlock Classes="tableHeader" Text="SL" />
              <TextBlock Grid.Column="1" Classes="tableHeader" Text="CUSTOMER" />
              <TextBlock Grid.Column="2" Classes="tableHeader" Text="INVOICES" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="3" Classes="tableHeader" Text="BILLED" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="4" Classes="tableHeader" Text="COLLECTED" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="5" Classes="tableHeader" Text="OUTSTANDING" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding RevenueRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#E4DEE8" BorderThickness="0,0,0,1" Padding="20,13">
                  <Grid ColumnDefinitions="44,2*,*,*,*,*">
                    <TextBlock Classes="tableCell" Text="{Binding Index}" Foreground="#777777" />
                    <TextBlock Grid.Column="1" Classes="tableCell" Text="{Binding Name}" />
                    <TextBlock Grid.Column="2" Classes="tableCell" Text="{Binding InvoiceCount}" HorizontalAlignment="Center" Foreground="#777777" />
                    <TextBlock Grid.Column="3" Classes="tableCell" Text="{Binding Billed}" HorizontalAlignment="Right" Foreground="#777777" />
                    <TextBlock Grid.Column="4" Classes="tableCell" Text="{Binding Collected}" HorizontalAlignment="Right" Foreground="#16A34A" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Classes="tableCell" Text="{Binding Outstanding}" HorizontalAlignment="Right" Foreground="#EF4444" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto" Margin="20,13">
            <TextBlock Text="{Binding RevenueRange}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="‹    Page 1 of 1    ›" FontSize="13" FontWeight="SemiBold" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="customerReportCard" IsVisible="{Binding IsStatement}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="20,14,14,8">
            <StackPanel>
              <TextBlock Text="Customer" FontSize="11" Foreground="#777777" Margin="10,0,0,-4" ZIndex="1" />
              <ComboBox ItemsSource="{Binding CustomerOptions}"
                        SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                        MinHeight="42"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Classes="exportButton" Command="{Binding ExportCsvCommand}" ToolTip.Tip="Export customer statement as CSV" Content="↓  Export CSV" />
              <Button Classes="exportButton" Command="{Binding ExportPdfCommand}" ToolTip.Tip="Export customer statement as PDF" Content="↓  Export PDF" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,6,20,10">
            <TextBlock Text="{Binding SelectedCustomerName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="#E5E9F3" CornerRadius="5" Padding="8,4">
              <TextBlock Text="INR" FontSize="11" Foreground="#0D47A1" FontWeight="SemiBold" />
            </Border>
          </StackPanel>

          <Grid ColumnDefinitions="*,14,*,14,*" RowDefinitions="Auto,14,Auto" Margin="20,0,20,18">
            <Border Grid.Column="0" Background="#FBF5FF" BorderBrush="#E4DEE8" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="12"><TextBlock Text="▣  Opening" Foreground="#777777" FontSize="12" /><TextBlock Text="Rs. 0.00" Foreground="#777777" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#FBF5FF" BorderBrush="#E4DEE8" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="12"><TextBlock Text="▤  Invoiced" Foreground="#777777" FontSize="12" /><TextBlock Text="{Binding SelectedInvoiced}" Foreground="#0D47A1" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#FBF5FF" BorderBrush="#E4DEE8" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="12"><TextBlock Text="▣  Paid" Foreground="#777777" FontSize="12" /><TextBlock Text="{Binding SelectedPaid}" Foreground="#16A34A" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" Background="#FBF5FF" BorderBrush="#E4DEE8" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="12"><TextBlock Text="▧  Closing" Foreground="#777777" FontSize="12" /><TextBlock Text="{Binding SelectedClosing}" Foreground="#7C3AED" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Background="#FBF5FF" BorderBrush="#E4DEE8" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="12"><TextBlock Text="⚠  Overdue" Foreground="#777777" FontSize="12" /><TextBlock Text="{Binding SelectedOverdue}" Foreground="#EF4444" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Border>
          </Grid>

          <Border Background="White" BorderBrush="#E4DEE8" BorderThickness="0,1,0,1" Padding="20,9">
            <Grid ColumnDefinitions="42,100,86,130,2*,*,*,*">
              <TextBlock Classes="tableHeader" Text="SL" />
              <TextBlock Grid.Column="1" Classes="tableHeader" Text="DATE" />
              <TextBlock Grid.Column="2" Classes="tableHeader" Text="TYPE" />
              <TextBlock Grid.Column="3" Classes="tableHeader" Text="REFERENCE" />
              <TextBlock Grid.Column="4" Classes="tableHeader" Text="DESCRIPTION" />
              <TextBlock Grid.Column="5" Classes="tableHeader" Text="DEBIT" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="6" Classes="tableHeader" Text="CREDIT" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="7" Classes="tableHeader" Text="BALANCE" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding StatementRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#E4DEE8" BorderThickness="0,0,0,1" Padding="20,13">
                  <Grid ColumnDefinitions="42,100,86,130,2*,*,*,*">
                    <TextBlock Classes="tableCell" Text="{Binding Index}" Foreground="#777777" />
                    <TextBlock Grid.Column="1" Classes="tableCell" Text="{Binding Date}" Foreground="#777777" />
                    <TextBlock Grid.Column="2" Classes="tableCell" Text="{Binding Type}" Foreground="{Binding TypeColor}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Classes="tableCell" Text="{Binding Reference}" Foreground="#777777" />
                    <TextBlock Grid.Column="4" Classes="tableCell" Text="{Binding Description}" Foreground="#777777" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="5" Classes="tableCell" Text="{Binding Debit}" HorizontalAlignment="Right" Foreground="#777777" />
                    <TextBlock Grid.Column="6" Classes="tableCell" Text="{Binding Credit}" HorizontalAlignment="Right" Foreground="#16A34A" />
                    <TextBlock Grid.Column="7" Classes="tableCell" Text="{Binding Balance}" HorizontalAlignment="Right" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border IsVisible="{Binding HasNoStatementRows}" Padding="20,22">
            <TextBlock Text="No statement activity for this customer." Foreground="#777777" HorizontalAlignment="Center" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
