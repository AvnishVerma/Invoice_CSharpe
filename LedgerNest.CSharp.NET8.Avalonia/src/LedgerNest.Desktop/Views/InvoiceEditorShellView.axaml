<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LedgerNest.Desktop.Views" xmlns:vm="using:LedgerNest.Desktop"
             x:Class="LedgerNest.Desktop.Views.InvoiceEditorShellView" x:CompileBindings="False">

  <UserControl.Styles>
    <Style Selector="TextBlock#HeaderDate"><Setter Property="Margin" Value="12,0" /><Setter Property="FontSize" Value="20" /></Style>
    <Style Selector="TextBlock#HeaderDate.narrow"><Setter Property="Margin" Value="8,0" /><Setter Property="FontSize" Value="14" /></Style>



    <Style Selector="Expander /template/ ToggleButton"><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="NumericUpDown /template/ TextBox"><Setter Property="MinHeight" Value="29" /><Setter Property="Padding" Value="6,3" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <local:PageHeaderView Title="{Binding Title}">
      <local:PageHeaderView.CenterContent><TextBlock x:Name="HeaderDate" Text="{Binding DateText}" Classes.narrow="{Binding IsNarrow}" Foreground="White" VerticalAlignment="Center" /></local:PageHeaderView.CenterContent>
      <local:PageHeaderView.HeaderActions><StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding NumberText}" Foreground="White" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding !IsNarrow}" />
        <Button Classes="action-icon header-icon-action" Command="{Binding VoidCommand}" IsVisible="{Binding ShowVoid}" ToolTip.Tip="Void Invoice"><TextBlock Text="block" Classes="action-icon-glyph" /></Button>
      </StackPanel></local:PageHeaderView.HeaderActions>
    </local:PageHeaderView>
    <local:InvoiceWorkspace Grid.Row="1" DataContext="{Binding}" Margin="10" />
    <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppOutlineBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel IsVisible="{Binding !IsNarrow}">
          <local:ActionButtonView ActionLabel="View" Caption="View" Tooltip="View last saved document" Command="{Binding ViewCommand}" />
          <local:ActionButtonView ActionLabel="Preview" Caption="Preview" Tooltip="Preview last saved PDF" Command="{Binding PreviewCommand}" />
          <local:ActionButtonView ActionLabel="Download" Caption="Download" Tooltip="Download last saved PDF" Command="{Binding DownloadCommand}" />
          <local:ActionButtonView ActionLabel="Print" Caption="Print" Tooltip="Print last saved document" Command="{Binding PrintCommand}" />
        </WrapPanel>
        <Button Grid.Column="1" Classes="action primary" Content="{Binding SaveCaption}" Tag="{Binding SaveCaption}" Command="{Binding CreateCommand}" ToolTip.Tip="Save invoice (Ctrl+S)" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
