<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.SettingsSaveRailView">
  <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="*,Auto">
      <Border Grid.Row="1" Padding="13"><ContentControl x:Name="SaveHost" /></Border>
    </Grid>
  </Border>
</UserControl>
