<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.InvoiceLineItemsView"
             x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="6" IsVisible="{Binding HasLines}">
      <Grid ColumnDefinitions="*,70,85,60,80,90,40">
        <TextBlock Text="ITEM" FontSize="11" FontWeight="Bold" />
        <TextBlock Grid.Column="1" Text="QTY" FontSize="11" FontWeight="Bold" />
        <TextBlock Grid.Column="2" Text="PRICE" FontSize="11" FontWeight="Bold" />
        <TextBlock Grid.Column="3" Text="TAX %" FontSize="11" FontWeight="Bold" />
        <TextBlock Grid.Column="4" Text="DISCOUNT" FontSize="11" FontWeight="Bold" />
        <TextBlock Grid.Column="5" Text="TOTAL" FontSize="11" FontWeight="Bold" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
      <Grid MinWidth="650">
        <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1" Padding="6">
                <Grid ColumnDefinitions="*,70,85,60,80,90,40">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Line.Name}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UnitText}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" />
                    <TextBlock Text="{Binding ProductTypeText}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" IsVisible="{Binding ShowProductType}" />
                  </StackPanel>
                  <NumericUpDown Grid.Column="1" Value="{Binding Line.Quantity, Mode=TwoWay}" Minimum="0.001" Maximum="1000000000" Increment="1" FormatString="0.##" ShowButtonSpinner="False" Margin="2" MinHeight="29" Padding="6,3" />
                  <NumericUpDown Grid.Column="2" Value="{Binding Line.Price, Mode=TwoWay}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.##" ShowButtonSpinner="False" Margin="2" MinHeight="29" Padding="6,3" />
                  <NumericUpDown Grid.Column="3" Value="{Binding Line.TaxRate, Mode=TwoWay}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.##" ShowButtonSpinner="False" Margin="2" MinHeight="29" Padding="6,3" />
                  <NumericUpDown Grid.Column="4" Value="{Binding Line.Discount, Mode=TwoWay}" Minimum="0" Maximum="1000000000" Increment="1" FormatString="0.##" ShowButtonSpinner="False" Margin="2" MinHeight="29" Padding="6,3" />
                  <TextBlock Grid.Column="5" Text="{Binding Line.Total, StringFormat={}{0:0.00}}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                  <Button Grid.Column="6" Content="×" Command="{Binding RemoveCommand}" MinHeight="29" Padding="6,3" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel IsVisible="{Binding HasNoLines}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="shopping_cart" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="34" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="No items added yet" FontSize="16" HorizontalAlignment="Center" />
          <TextBlock Text="Search above to add a product, or add a custom item." FontSize="13" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
