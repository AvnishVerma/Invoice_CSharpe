<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.ReportsPageView"
             x:CompileBindings="False">
  <UserControl.Resources>
    <local:ReportTabIconConverter x:Key="ReportTabIconConverter" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Background="#003B87" Padding="18,10">
      <Grid ColumnDefinitions="*,Auto" MinHeight="38">
        <TextBlock Text="Reports" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh reports" Background="Transparent" BorderThickness="0" Padding="8">
          <TextBlock Text="↻" Foreground="White" FontSize="22" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ListBox ItemsSource="{Binding ReportTabs}"
                 SelectedItem="{Binding SelectedReport, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="14,8" />
              <Setter Property="Margin" Value="2,0" />
              <Setter Property="CornerRadius" Value="8" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Background" Value="#E2E8F0" />
              <Setter Property="Foreground" Value="#0D47A1" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.SelectReportCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}"
                      Tag="{Binding}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      FontSize="13">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Converter={StaticResource ReportTabIconConverter}}"
                             FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                             FontSize="17"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="200,*">
      <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16" Spacing="8">
            <TextBlock Text="CURRENCY" FontSize="11" FontWeight="Bold" Foreground="#777777" />
            <RadioButton GroupName="ReportCurrency" IsChecked="True" Margin="0,2">
              <TextBlock Text="Current selected currency (Indian Rupee)" TextWrapping="Wrap" FontWeight="SemiBold" />
            </RadioButton>
            <RadioButton GroupName="ReportCurrency" Content="All currencies" Margin="0,2" />

            <Separator Margin="0,8" />

            <TextBlock Text="PERIOD" FontSize="11" FontWeight="Bold" Foreground="#777777" />
            <RadioButton GroupName="ReportPeriod" Content="Last 30 days" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="Last 3 months" IsChecked="{Binding IsThreeMonthPeriod, Mode=OneWay}" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="Last 6 months" IsChecked="{Binding IsSixMonthPeriod, Mode=OneWay}" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="This year" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="This FY" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="Last FY" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="Custom…" Margin="0,2" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" />
    </Grid>
  </Grid>
</UserControl>
