<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.ReportsPageView"
             x:CompileBindings="False">
  <UserControl.Resources>
    <local:ReportTabIconConverter x:Key="ReportTabIconConverter" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Background="{DynamicResource PageHeaderBrush}" Padding="14.4,8">
      <Grid ColumnDefinitions="*,Auto" MinHeight="30.4">
        <TextBlock loc:UiLocalization.Text="Reports" Foreground="{DynamicResource AppCardBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh reports" Background="Transparent" BorderThickness="0" Padding="6.4">
          <TextBlock Text="↻" Foreground="{DynamicResource AppCardBrush}" FontSize="22" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1" Padding="6.4,4.8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ListBox ItemsSource="{Binding ReportTabs}"
                 SelectedItem="{Binding SelectedReport, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3.2" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="14,8" />
              <Setter Property="Margin" Value="2,0" />
              <Setter Property="CornerRadius" Value="8" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
            </Style>
            <Style Selector="Button.report-tab /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style Selector="Button.report-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style Selector="Button.report-tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Button Classes="report-tab"
                      Command="{Binding DataContext.SelectReportCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}"
                      Tag="{Binding}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      FontSize="13">
                <StackPanel Orientation="Horizontal" Spacing="6.4">
                  <TextBlock Text="{Binding Converter={StaticResource ReportTabIconConverter}}"
                             FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                             FontSize="17"
                             VerticalAlignment="Center" />
                  <TextBlock loc:UiLocalization.Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="200,*">
      <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16" Spacing="6.4">
            <TextBlock loc:UiLocalization.Text="CURRENCY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
            <RadioButton GroupName="ReportCurrency" IsChecked="True" Margin="0,2">
              <TextBlock loc:UiLocalization.Text="Current selected currency (Indian Rupee)" TextWrapping="Wrap" FontWeight="SemiBold" />
            </RadioButton>
            <RadioButton GroupName="ReportCurrency" Content="All currencies" Margin="0,2" />

            <Separator Margin="0,8" />

            <TextBlock loc:UiLocalization.Text="PERIOD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
            <RadioButton GroupName="ReportPeriod" Content="Last 30 days" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="Last 3 months" IsChecked="{Binding IsThreeMonthPeriod, Mode=OneWay}" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="Last 6 months" IsChecked="{Binding IsSixMonthPeriod, Mode=OneWay}" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="This year" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="This FY" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="Last FY" Margin="0,2" />
            <RadioButton GroupName="ReportPeriod" Content="Custom…" Margin="0,2" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" />
    </Grid>
  </Grid>
</UserControl>
