<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LedgerNest.Desktop"
             x:Class="LedgerNest.Desktop.Views.CustomizationOffersView"
             x:CompileBindings="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock loc:UiLocalization.Text="MADE FOR YOUR BUSINESS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" />
      <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding Offers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,16" Padding="24" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
                <Button Content="Request Customization" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
