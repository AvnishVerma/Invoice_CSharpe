<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.InvoiceOptionsPanelView">
  <Border CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
      <ContentControl x:Name="OptionsHost" />
    </ScrollViewer>
  </Border>
</UserControl>
