<UserControl xmlns:icons="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" xmlns:local="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.InvoiceOptionsPanelView" x:DataType="vm:InvoiceOptionsViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Views/InvoiceTabStyles.axaml"/>
    <Style Selector="local|InvoiceOptionsPanelView.charges-only :is(Control).adjustments-section, local|InvoiceOptionsPanelView.charges-only :is(Control).tax-section"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="local|InvoiceOptionsPanelView.adjustments-only :is(Control).charges-section, local|InvoiceOptionsPanelView.adjustments-only :is(Control).tax-section"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="local|InvoiceOptionsPanelView.tax-only :is(Control).charges-section, local|InvoiceOptionsPanelView.tax-only :is(Control).adjustments-section"><Setter Property="IsVisible" Value="False"/></Style>
  </UserControl.Styles>
  <Border Classes="invoice-tab-card">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Classes="invoice-tab-content">
        <Border Classes="charges-section">
          <StackPanel Classes="invoice-tab-content" x:Name="ChargesAndAdjustments" AutomationProperties.Name="Charges and adjustments">
            <StackPanel Classes="invoice-tab-heading"><Border Classes="invoice-tab-icon"><TextBlock Text="{icons:FontAwesomeGlyph add_box}" Classes="action-icon-glyph"/></Border><TextBlock vm:UiLocalization.Text="Charges" Classes="invoice-tab-title"/><Border Background="{DynamicResource AppAccentBrush}" CornerRadius="10" Width="20" Height="20" IsVisible="{Binding HasCosts}"><TextBlock Text="{Binding CostCount}" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
            <StackPanel Classes="invoice-tab-content">
              <TextBlock vm:UiLocalization.Text="Use a minus sign for deductions (e.g. freight paid by buyer)." FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Costs}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:InvoiceCostRowViewModel">
                <Grid ColumnDefinitions="3*,8,2*,Auto" Margin="0,4">
                  <local:FormFieldView DataContext="{Binding LabelField}" /><local:FormFieldView Grid.Column="2" DataContext="{Binding AmountField}" />
                  <Button Grid.Column="3" Classes="action-icon text" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove adjustment" AutomationProperties.Name="Remove adjustment" Foreground="#F44336" Margin="4,0,0,0"><TextBlock Text="{icons:FontAwesomeGlyph remove_circle_outline}" Classes="action-icon-glyph" /></Button>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <local:ActionButtonView ActionLabel="Add" Caption="Add Row" Icon="add_circle_outline" Tooltip="Add a charge or adjustment" Command="{Binding AddCostCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Classes="adjustments-section invoice-tab-content">
          <StackPanel Classes="invoice-tab-heading"><Border Classes="invoice-tab-icon"><TextBlock Text="{icons:FontAwesomeGlyph edit}" Classes="action-icon-glyph"/></Border><TextBlock vm:UiLocalization.Text="Adjustments" Classes="invoice-tab-title"/></StackPanel>
          <Border>
          <Grid ColumnDefinitions="*,8,Auto"><local:FormFieldView DataContext="{Binding DiscountAmount}" /><ComboBox Grid.Column="2" ItemsSource="{Binding DiscountModes}" SelectedItem="{Binding DiscountMode, Mode=TwoWay}" MinWidth="76" VerticalAlignment="Center" AutomationProperties.Name="Invoice discount type" /></Grid>
        </Border>
        </StackPanel>
        <TextBlock Classes="adjustments-section" vm:UiLocalization.Text="NOTES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedBrush}" />
        <local:FormFieldView Classes="adjustments-section" DataContext="{Binding NotesField}" />
        <Border Classes="adjustments-section"><Expander Header="Custom fields" HorizontalAlignment="Stretch" IsVisible="{Binding HasCustomFields}"><local:FormFieldsView DataContext="{Binding CustomFields}" /></Expander></Border>
        <StackPanel Classes="tax-section invoice-tab-content"><StackPanel Classes="invoice-tab-heading"><Border Classes="invoice-tab-icon"><TextBlock Text="{icons:FontAwesomeGlyph percent}" Classes="action-icon-glyph"/></Border><TextBlock vm:UiLocalization.Text="Tax Details" Classes="invoice-tab-title"/></StackPanel><StackPanel Classes="invoice-tab-content"><local:FormFieldsView DataContext="{Binding TaxFields}" /><local:FormFieldView DataContext="{Binding InterStateField}" /></StackPanel></StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
