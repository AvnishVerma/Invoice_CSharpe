<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LedgerNest.Desktop" x:Class="LedgerNest.Desktop.Views.StatisticsView"
             x:Name="Root" x:CompileBindings="False">
  <ItemsControl ItemsSource="{Binding}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><UniformGrid Columns="{Binding #Root.ColumnCount}" /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
              <TextBlock loc:UiLocalization.Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
              <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" />
              <TextBlock loc:UiLocalization.Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource AppMutedBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Width="32" Height="32" CornerRadius="10" Background="{Binding IconBackground}" VerticalAlignment="Center">
              <TextBlock Text="{Binding Icon}" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                         FontSize="16" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
