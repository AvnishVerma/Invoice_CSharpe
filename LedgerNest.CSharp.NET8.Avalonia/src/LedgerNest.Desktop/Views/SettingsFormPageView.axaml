<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" xmlns:views="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.SettingsFormPageView" x:DataType="vm:SettingsFormPageViewModel" x:Name="Root">
  <views:ScreenScaffoldView>
    <views:ScreenScaffoldView.PageHeader>
      <views:PageHeaderView Title="{Binding Title}" DataContext="{Binding DataContext, ElementName=Root}" />
    </views:ScreenScaffoldView.PageHeader>
    <views:ScreenScaffoldView.PageBody>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PageContentPadding}" MaxWidth="900" Spacing="16">
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsFormSection">
                <views:SettingsSectionView Title="{Binding Title}" Margin="0,0,0,16">
                  <views:SettingsSectionView.Body><views:FormFieldsView DataContext="{Binding Fields}" /></views:SettingsSectionView.Body>
                </views:SettingsSectionView>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <views:SettingsActionsView SaveCommand="{Binding SaveCommand}" />
        </StackPanel>
      </ScrollViewer>
    </views:ScreenScaffoldView.PageBody>
  </views:ScreenScaffoldView>
</UserControl>
