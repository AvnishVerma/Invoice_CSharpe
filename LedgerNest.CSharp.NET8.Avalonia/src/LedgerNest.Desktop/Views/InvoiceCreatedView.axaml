<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.InvoiceCreatedView">
  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource PageHeaderBrush}"
            Height="44.8"
            Padding="16,0">
      <Grid ColumnDefinitions="*,Auto,*">
        <TextBlock loc:UiLocalization.Text="Invoice Created"
                   Foreground="White"
                   FontSize="20"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="DateText"
                   Grid.Column="1"
                   Foreground="White"
                   FontSize="20"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="InvoiceNumberText"
                   Grid.Column="2"
                   Foreground="White"
                   FontSize="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Background="{DynamicResource CanvasBrush}">
      <Border Padding="0">
        <Border Width="480"
                MinHeight="500"
                CornerRadius="22"
                Padding="27.2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 6 18 0 #37000000">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#EEF9F0" Offset="0" />
              <GradientStop Color="#FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>

          <StackPanel Spacing="16"
                      HorizontalAlignment="Center">
            <Border Width="112"
                    Height="89.6"
                    CornerRadius="56"
                    Background="#C8EBCB"
                    HorizontalAlignment="Center">
              <Border Width="64"
                      Height="51.2"
                      CornerRadius="32"
                      Background="#338E3C"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                <TextBlock Text=""
                           FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                           FontSize="58"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </Border>

            <TextBlock loc:UiLocalization.Text="Invoice Created Successfully!"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <Border Background="{DynamicResource AppCardBrush}"
                    CornerRadius="18"
                    Padding="12.8,6.4"
                    HorizontalAlignment="Center">
              <TextBlock x:Name="InvoiceIdText"
                         Foreground="#1E88E5"
                         FontSize="16"
                         FontWeight="Bold" />
            </Border>

            <StackPanel Orientation="Horizontal"
                        Spacing="14.4"
                        HorizontalAlignment="Center">
              <StackPanel Spacing="6.4">
                <Button x:Name="ViewButton"
                        Width="72"
                        Height="57.6"
                        Background="#1A4CAF50"
                        BorderBrush="#594CAF50"
                        BorderThickness="2">
                  <TextBlock Text=""
                             FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                             FontSize="34"
                             Foreground="#4CAF50" />
                </Button>
                <TextBlock loc:UiLocalization.Text="View Details"
                           Foreground="#4CAF50"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Center" />
              </StackPanel>
                <StackPanel x:Name="PaymentActionPanel"
                            Spacing="6.4">
                    <Button x:Name="ApplyPaymentButton"
                            Tag="Apply Payment"
                            Width="72"
                            Height="57.6"
                            Background="#1A009688"
                            BorderBrush="#59009688"
                            BorderThickness="2">
                        <TextBlock Text=""
                                   FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                                   FontSize="34"
                                   Foreground="#00897B" />
                    </Button>
                    <TextBlock loc:UiLocalization.Text="Payment"
                               Foreground="#00897B"
                               FontSize="13"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6.4">
                <Button x:Name="PreviewButton"
                        Width="72"
                        Height="57.6"
                        Background="#1A9C27B0"
                        BorderBrush="#599C27B0"
                        BorderThickness="2">
                  <TextBlock Text=""
                             FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                             FontSize="34"
                             Foreground="#9C27B0" />
                </Button>
                <TextBlock loc:UiLocalization.Text="Preview PDF"
                           Foreground="#9C27B0"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Center" />
              </StackPanel>

              <StackPanel Spacing="6.4">
                <Button x:Name="PrintButton"
                        Width="72"
                        Height="57.6"
                        Background="#1A2196F3"
                        BorderBrush="#592196F3"
                        BorderThickness="2">
                  <TextBlock Text=""
                             FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                             FontSize="34"
                             Foreground="#2196F3" />
                </Button>
                <TextBlock loc:UiLocalization.Text="Print Invoice"
                           Foreground="#2196F3"
                           FontSize="13"
                           FontWeight="Bold"
                           TextAlignment="Center" />
              </StackPanel>

            </StackPanel>

            <Button x:Name="CreateNewButton"
                    Tag="Create New Invoice"
                    HorizontalAlignment="Stretch"
                    MinHeight="41.6"
                    Classes="primary">
              <Grid ColumnDefinitions="Auto,10,*">
                <TextBlock Text=""
                           FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                           FontSize="18"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           loc:UiLocalization.Text="Create New Invoice (Shortcut: Ctrl+q)"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>
      </Border>

    </Grid>
  </Grid>
</UserControl>
