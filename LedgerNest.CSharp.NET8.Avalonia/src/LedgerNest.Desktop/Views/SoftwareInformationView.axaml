<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" xmlns:updates="using:LedgerNest.Desktop.Updates"
             xmlns:views="using:LedgerNest.Desktop.Views" x:Class="LedgerNest.Desktop.Views.SoftwareInformationView" x:DataType="vm:SoftwareInformationViewModel">
  <Grid RowDefinitions="Auto,*"><Border Classes="page-header"><TextBlock Text="Software Information" Classes="page-header-title"/></Border><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"><Grid Margin="{DynamicResource PageContentPadding}" ColumnDefinitions="320,16,*" MinWidth="760"><StackPanel Spacing="12"><views:BrandLogo HorizontalAlignment="Left"/><Border Classes="settings-column"><StackPanel Spacing="8"><TextBlock Text="App Details" Classes="settings-section-title"/><TextBlock Text="{Binding AppName, StringFormat='App name: {0}'}"/><TextBlock Text="{Binding Version, StringFormat='Version: {0}'}"/><TextBlock Text="{Binding Build, StringFormat='Build: {0}'}" IsVisible="{Binding HasBuild}" Foreground="{DynamicResource AppMutedBrush}"/><TextBlock Text="Platform: Desktop"/><TextBlock Text="License: See legacy LICENSE" Foreground="{DynamicResource AppMutedBrush}"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="2" Spacing="12"><Border Classes="settings-column"><StackPanel Spacing="10"><TextBlock Text="Application Updates" Classes="settings-section-title"/><TextBlock Text="Configure the publisher HTTPS manifest used to announce new versions." Foreground="{DynamicResource AppMutedBrush}"/><TextBox Text="{Binding ManifestUrl, Mode=TwoWay}" PlaceholderText="HTTPS update manifest URL"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save update channel" Command="{Binding SaveChannelCommand}"/><Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"/></StackPanel><TextBlock Text="Update status" FontWeight="Bold" FontSize="12"/><TextBlock Text="{Binding UpdateStatus}"/><TextBlock Text="No release information has been received yet." IsVisible="{Binding !HasLatestVersion}" Foreground="{DynamicResource AppMutedBrush}"/><TextBlock Text="{Binding LatestVersion, StringFormat='Available version: {0}'}" IsVisible="{Binding HasLatestVersion}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}"/><TextBlock Text="{Binding LatestNotes}" IsVisible="{Binding HasLatestNotes}" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/><Button Content="Download update" Command="{Binding OpenDownloadCommand}" IsVisible="{Binding HasDownload}" Classes="action primary" HorizontalAlignment="Left"/></StackPanel></Border><Border Classes="settings-column"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Notifications" Classes="settings-section-title"/><Button Grid.Column="1" Content="Mark read" Command="{Binding MarkReadCommand}"/></Grid><TextBlock Text="No application notifications." IsVisible="{Binding !HasNotifications}" Foreground="{DynamicResource AppMutedBrush}"/><ItemsControl ItemsSource="{Binding Notifications}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="updates:AppNotification"><Border Classes="card" Padding="10" Margin="0,0,0,6"><StackPanel Spacing="3"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Change Password" Command="{Binding ChangePasswordCommand}"/><Button Content="First-time Setup" Command="{Binding OnboardingCommand}"/></StackPanel></StackPanel></Grid></ScrollViewer></Grid>
</UserControl>
