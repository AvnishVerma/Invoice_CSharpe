<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.SoftwareInformationView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid Margin="{DynamicResource PageContentPadding}" ColumnDefinitions="320,16,*" MinWidth="760">
      <StackPanel Spacing="12">
        <ContentControl x:Name="LogoHost" />
        <Border Classes="settings-column"><ContentControl x:Name="DetailsHost" /></Border>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="12">
        <Border Classes="settings-column"><ContentControl x:Name="UpdatesHost" /></Border>
        <Border Classes="settings-column"><ContentControl x:Name="NotificationsHost" /></Border>
        <ContentControl x:Name="ActionsHost" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
