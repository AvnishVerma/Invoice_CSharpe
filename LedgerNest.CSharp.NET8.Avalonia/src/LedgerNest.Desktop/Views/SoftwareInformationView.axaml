<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" xmlns:updates="using:LedgerNest.Desktop.Updates" xmlns:views="using:LedgerNest.Desktop.Views" x:Class="LedgerNest.Desktop.Views.SoftwareInformationView" x:DataType="vm:SoftwareInformationViewModel" xmlns:shared="using:LedgerNest.Desktop.Views" x:Name="PageRoot">
  <shared:ScreenScaffoldView>
    <shared:ScreenScaffoldView.PageHeader>
      <shared:PageHeaderView Title="Software Information" DataContext="{Binding DataContext, ElementName=PageRoot}" />
    </shared:ScreenScaffoldView.PageHeader>
    <shared:ScreenScaffoldView.PageBody>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
        <StackPanel Margin="{DynamicResource PageContentPadding}" Spacing="12">
          <StackPanel Spacing="12">
            <views:BrandLogo HorizontalAlignment="Left" />
            <Border Classes="settings-column">
              <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="App Details" Classes="settings-section-title" />
                <TextBlock TextWrapping="Wrap" Text="{Binding AppName, StringFormat='App name: {0}'}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding Version, StringFormat='Version: {0}'}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding Build, StringFormat='Build: {0}'}" IsVisible="{Binding HasBuild}" Foreground="{DynamicResource AppMutedBrush}" />
                <TextBlock TextWrapping="Wrap" Text="Platform: Desktop" />
                <TextBlock TextWrapping="Wrap" Text="License: See legacy LICENSE" Foreground="{DynamicResource AppMutedBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="12">
            <Border Classes="settings-column">
              <StackPanel Spacing="10">
                <TextBlock TextWrapping="Wrap" Text="Application Updates" Classes="settings-section-title" />
                <TextBlock TextWrapping="Wrap" Text="Configure the publisher HTTPS manifest used to announce new versions." Foreground="{DynamicResource AppMutedBrush}" />
                <TextBox Text="{Binding ManifestUrl, Mode=TwoWay}" PlaceholderText="HTTPS update manifest URL" />
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="settings-save-source" Content="Save update channel" Command="{Binding SaveChannelCommand}" />
                  <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
                </WrapPanel>
                <TextBlock TextWrapping="Wrap" Text="Update status" FontWeight="Bold" FontSize="12" />
                <TextBlock TextWrapping="Wrap" Text="{Binding UpdateStatus}" />
                <TextBlock TextWrapping="Wrap" Text="No release information has been received yet." IsVisible="{Binding !HasLatestVersion}" Foreground="{DynamicResource AppMutedBrush}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding LatestVersion, StringFormat='Available version: {0}'}" IsVisible="{Binding HasLatestVersion}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding LatestNotes}" IsVisible="{Binding HasLatestNotes}" Foreground="{DynamicResource AppMutedBrush}" />
                <Button Content="Download update" Command="{Binding OpenDownloadCommand}" IsVisible="{Binding HasDownload}" Classes="action primary" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Classes="settings-column">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock TextWrapping="Wrap" Text="Notifications" Classes="settings-section-title" />
                  <Button Grid.Column="1" Content="Mark read" Command="{Binding MarkReadCommand}" />
                </Grid>
                <TextBlock TextWrapping="Wrap" Text="No application notifications." IsVisible="{Binding !HasNotifications}" Foreground="{DynamicResource AppMutedBrush}" />
                <ItemsControl ItemsSource="{Binding Notifications}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="updates:AppNotification">
                      <Border Classes="card" Padding="10" Margin="0,0,0,6">
                        <StackPanel Spacing="3">
                          <TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontWeight="Bold" />
                          <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
                          <TextBlock TextWrapping="Wrap" Text="{Binding CreatedAt}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <WrapPanel Orientation="Horizontal">
              <Button Content="Change Password" Command="{Binding ChangePasswordCommand}" />
              <Button Content="First-time Setup" Command="{Binding OnboardingCommand}" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </shared:ScreenScaffoldView.PageBody>
  </shared:ScreenScaffoldView>
</UserControl>
