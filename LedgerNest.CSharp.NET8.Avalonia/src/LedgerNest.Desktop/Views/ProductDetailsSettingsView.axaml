<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop"
             x:Class="LedgerNest.Desktop.Views.ProductDetailsSettingsView" x:DataType="vm:ProductDetailsSettingsViewModel">
  <UserControl.Resources><DataTemplate x:Key="FieldRow" x:DataType="vm:ProductFieldOption"><Border Classes="card" Padding="12" Margin="0,0,0,6"><Grid ColumnDefinitions="28,12,*,Auto"><TextBlock Text="{Binding Icon}" Classes="action-icon-glyph" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontSize="15"/><TextBlock Text="{Binding Help}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch Grid.Column="3" IsChecked="{Binding Field.IsChecked, Mode=TwoWay}" IsEnabled="{Binding !Required}"/></Grid></Border></DataTemplate></UserControl.Resources>
  <Grid RowDefinitions="Auto,*"><Border Classes="page-header"><TextBlock Text="Customize Product Details" Classes="page-header-title"/></Border><Grid Grid.Row="1" ColumnDefinitions="240,*"><Border BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,1,0"><Grid RowDefinitions="*,Auto"><TextBlock Margin="20" Text="Choose the product fields your business uses. Required fields remain enabled." Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap"/><Button Grid.Row="1" Content="Save" Command="{Binding SaveCommand}" Classes="action primary" Margin="14"/></Grid></Border><ScrollViewer Grid.Column="1"><StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Choose which fields appear on product forms, lists, and invoice line items." Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding RequiredFields}" ItemTemplate="{StaticResource FieldRow}"/><TextBlock Text="Product fields" FontWeight="SemiBold" Margin="0,10,0,6"/><ItemsControl ItemsSource="{Binding ProductFields}" ItemTemplate="{StaticResource FieldRow}"/><ItemsControl ItemsSource="{Binding MetadataFields}" IsVisible="{Binding MetadataMaster.IsChecked}" Margin="44,4,0,8" ItemTemplate="{StaticResource FieldRow}"/><TextBlock Text="Invoice" FontWeight="SemiBold" Margin="0,10,0,6"/><ItemsControl ItemsSource="{Binding InvoiceFields}" ItemTemplate="{StaticResource FieldRow}"/></StackPanel></ScrollViewer></Grid></Grid>
</UserControl>

