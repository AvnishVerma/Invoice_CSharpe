<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.InvoiceQuickAddView">
  <Border Padding="8" CornerRadius="9" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,8,Auto">
        <ContentControl x:Name="SearchHost" />
        <ContentControl x:Name="CustomItemHost" Grid.Column="2" />
      </Grid>
      <ContentControl x:Name="SuggestionsHost" />
    </StackPanel>
  </Border>
</UserControl>
