<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LedgerNest.Desktop" xmlns:views="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.RevenueReportView" x:DataType="vm:RevenueReportViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18" Spacing="12">
      <views:ReportStatisticsView DataContext="{Binding Statistics}" />
      <Border IsVisible="{Binding HasMissingCosts}"><views:ReportNoticeView DataContext="{Binding Notice}" /></Border>
      <views:RevenueChartPanelView />
      <views:RevenueBreakdownPanelView />
    </StackPanel>
  </ScrollViewer>
</UserControl>
