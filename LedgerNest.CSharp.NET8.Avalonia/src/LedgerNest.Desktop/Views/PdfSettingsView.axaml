<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LedgerNest.Desktop" x:Class="LedgerNest.Desktop.Views.PdfSettingsView" x:DataType="vm:PdfSettingsViewModel" xmlns:shared="using:LedgerNest.Desktop.Views" x:Name="PageRoot">
  <shared:ScreenScaffoldView>
    <shared:ScreenScaffoldView.PageHeader>
      <shared:PageHeaderView Title="PDF Settings" DataContext="{Binding DataContext, ElementName=PageRoot}">
        <shared:PageHeaderView.HeaderActions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Reset to Default" Command="{Binding ResetCommand}" Classes="header-action" />
            <Button Content="Save Settings" Command="{Binding SaveCommand}" Classes="action primary" IsEnabled="{Binding HasChanges}" />
          </StackPanel>
        </shared:PageHeaderView.HeaderActions>
      </shared:PageHeaderView>
    </shared:ScreenScaffoldView.PageHeader>
    <shared:ScreenScaffoldView.PageBody>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="{DynamicResource PageContentPadding}" ColumnDefinitions="260,12,320,12,*" MinWidth="900">
          <Border Padding="12" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*">
              <StackPanel Spacing="6">
                <TextBlock Text="PAGE SIZE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
                <ComboBox ItemsSource="{Binding PageSize.Options}" SelectedItem="{Binding PageSize.Value, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="TEMPLATES" Margin="0,13,0,8" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppMutedBrush}" />
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Templates}" Margin="0,0,10,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PdfTemplateOptionViewModel">
                      <Button Tag="{Binding Name}" Command="{Binding $parent[UserControl].DataContext.SelectTemplateCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsVisible}" Classes="action pdf-template" Classes.selected="{Binding IsSelected}" MinHeight="88" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Padding="10">
                        <Grid ColumnDefinitions="62,10,*,Auto">
                          <shared:PdfTemplatePreviewView Width="58" Height="68" TemplateName="{Binding Name}" />
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{Binding Name}" FontSize="16" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" MaxHeight="36" />
                            <Border IsVisible="{Binding IsDefault}" Background="#E5E5E5" Padding="4,1" HorizontalAlignment="Left">
                              <TextBlock Text="Default" FontSize="11" />
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="check_circle" Classes="action-icon-glyph" Foreground="{DynamicResource AppPrimaryBrush}" IsVisible="{Binding IsSelected}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Column="2" Padding="16" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
            <ScrollViewer>
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Template.Value}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Display options" Foreground="{DynamicResource AppMutedBrush}" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#E7E2F2" CornerRadius="8" Padding="7,3">
                    <TextBlock Text="Active" Foreground="{DynamicResource AppPrimaryBrush}" />
                  </Border>
                </Grid>
                <TextBlock Text="DISPLAY OPTIONS" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
                <Border Classes="card" Padding="12" IsVisible="{Binding SupportsQuantity}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Show total quantity row" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTotalQuantity.IsChecked, Mode=TwoWay}" />
                  </Grid>
                </Border>
                <Border Classes="card" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Orientation" />
                    <StackPanel Orientation="Horizontal">
                      <Button Tag="Portrait" Content="✓ Portrait" Command="{Binding SetOrientationCommand}" CommandParameter="Portrait" Classes.selected="{Binding IsPortrait}" />
                      <Button Tag="Landscape" Content="✓ Landscape" Command="{Binding SetOrientationCommand}" CommandParameter="Landscape" Classes.selected="{Binding IsLandscape}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="THEME COLOR" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
                <Border Classes="card" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Theme Color" />
                    <ItemsControl ItemsSource="{Binding ThemeColors}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Width="20" Height="20" MinHeight="20" Padding="0" CornerRadius="10" Background="{Binding}" Command="{Binding $parent[UserControl].DataContext.SetThemeColorCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding ThemeColor.Value, Mode=TwoWay}" />
                    <Button Content="Default" Command="{Binding SetThemeColorCommand}" />
                  </StackPanel>
                </Border>
                <Expander Header="Printing &amp; advanced options">
                  <StackPanel Spacing="10" Margin="0,10,0,0">
                    <TextBlock Text="Item layout" />
                    <ComboBox ItemsSource="{Binding ItemLayout.Options}" SelectedItem="{Binding ItemLayout.Value, Mode=TwoWay}" />
                    <TextBlock Text="Company name size" />
                    <TextBox Text="{Binding CompanyNameSize.Value, Mode=TwoWay}" />
                    <TextBlock Text="Printer" />
                    <ComboBox ItemsSource="{Binding Printer.Options}" SelectedItem="{Binding Printer.Value, Mode=TwoWay}" />
                    <CheckBox Content="Show printer selection dialog" IsChecked="{Binding ShowPrinterDialog.IsChecked, Mode=TwoWay}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Column="4" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">
              <Border Padding="13,8">
                <TextBlock Text="Preview" FontWeight="Bold" />
              </Border>
              <Border Grid.Row="1" Margin="36,16" Background="White" BoxShadow="0 8 22 0 #22000000">
                <shared:PdfTemplatePreviewView TemplateName="{Binding Template.Value}" Accent="{Binding ThemeColor.Value}" />
              </Border>
              <Border Grid.Row="2" Padding="13,8">
                <TextBlock Text="Preview may slightly differ in the final PDF." FontSize="12" Foreground="{DynamicResource AppMutedBrush}" />
              </Border>
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </shared:ScreenScaffoldView.PageBody>
  </shared:ScreenScaffoldView>
</UserControl>