<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Scope dimensions to the settings content, preserving application/editor sizes. -->
  <Style Selector="ContentControl.settings-content TextBox, ContentControl.settings-content ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource TextInputHeight}" />
  </Style>
  <Style Selector="ContentControl.settings-content NumericUpDown">
    <Setter Property="Height" Value="{DynamicResource NumericInputHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource NumericInputHeight}" />
  </Style>
  <Style Selector="ContentControl.settings-content NumericUpDown /template/ TextBox">
    <Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="NaN" />
  </Style>
  <Style Selector="ContentControl.settings-content Button.action">
    <Setter Property="Height" Value="NaN" /><Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="ContentControl.settings-content CheckBox, ContentControl.settings-content ToggleSwitch, ContentControl.settings-content ToggleButton.form-toggle">
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="ContentControl.settings-content TextBlock.settings-description"><Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="ContentControl.settings-content Button.destructive"><Setter Property="Foreground" Value="Firebrick" /></Style>
  <ContainerQuery Name="settings" Query="max-width:640">
    <Style Selector="UniformGrid.settings-fields-row"><Setter Property="Columns" Value="1" /><Setter Property="Rows" Value="0" /></Style>
  </ContainerQuery>
</Styles>
