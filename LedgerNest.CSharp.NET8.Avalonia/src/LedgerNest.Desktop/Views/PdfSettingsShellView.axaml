<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.PdfSettingsShellView">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#FAFAFA" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
      <ContentControl x:Name="HeaderHost" />
    </Border>

    <ContentControl x:Name="ResponsiveHost" Grid.Row="1" />
  </Grid>
</UserControl>
