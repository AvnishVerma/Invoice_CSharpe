<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.PdfSettingsShellView">
  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource PageHeaderBrush}">
      <ContentControl x:Name="HeaderHost" />
    </Border>

    <ContentControl x:Name="ResponsiveHost" Grid.Row="1" />
  </Grid>
</UserControl>
