<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.SettingsPageView"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,Auto,*">
        <ContentControl Content="{Binding CurrentHeader}" />
        <Border Grid.Row="1" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource AppSurfaceBrush}" Padding="6,4">
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Label}"
                                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Label}"
                                    Classes="nav"
                                    Classes.selected="{Binding IsSelected}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    MinHeight="36"
                                    Margin="0"
                                    Padding="10,6"
                                    ToolTip.Tip="{Binding Label}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}"
                                               FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock loc:UiLocalization.Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentContent}" />
    </Grid>
</UserControl>
