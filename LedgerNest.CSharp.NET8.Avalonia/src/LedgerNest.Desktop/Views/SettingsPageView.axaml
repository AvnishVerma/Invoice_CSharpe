<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.SettingsPageView"
             x:CompileBindings="False">
  <Grid ColumnDefinitions="110,*">
    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="#FAFAFA">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tabs}" Margin="4,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Label}"
                      Tag="{Binding Label}"
                      Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding Label}"
                      Classes="nav"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="64"
                      Margin="4,0"
                      Padding="8"
                      ToolTip.Tip="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" />
  </Grid>
</UserControl>
