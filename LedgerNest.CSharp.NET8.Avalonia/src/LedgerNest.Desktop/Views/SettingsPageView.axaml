<UserControl xmlns:loc="using:LedgerNest.Desktop" xmlns:views="using:LedgerNest.Desktop.Views" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.SettingsPageView"
             x:CompileBindings="False" Container.Name="settings" Container.Sizing="Width">
    <UserControl.Styles><StyleInclude Source="/Views/SettingsStyles.axaml" /><StyleInclude Source="/Views/SideNavigationStyles.axaml"/>
      <Style Selector="Button.settings-save-source:not(.settings-save-primary)"><Setter Property="IsVisible" Value="False" /></Style></UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*" Background="{DynamicResource AppCanvasBrush}">
        <ContentControl Grid.ColumnSpan="2" Content="{Binding CurrentHeader}" VerticalAlignment="Top" />
        <Border Grid.Row="1" Grid.RowSpan="2" Classes="page-side-navigation" x:Name="SettingsNavigation">
            <ScrollViewer x:Name="SettingsNavigationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Label}"
                                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Label}"
                                    Classes="nav"
                                    Classes.selected="{Binding IsSelected}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    MinHeight="48"
                                    Margin="0"
                                    Padding="10,6"
                                    ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                                <Grid ColumnDefinitions="24,*">
                                    <TextBlock Text="{Binding Icon, Converter={StaticResource FontAwesomeGlyphConverter}}"
                                               FontFamily="{DynamicResource IconFontFamily}"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" loc:UiLocalization.Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ContentControl Classes="settings-content" Grid.Row="1" Grid.Column="1" x:Name="SettingsContent" Content="{Binding CurrentContent}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
        <Border Grid.Row="2" Grid.Column="1" IsVisible="{Binding HasSaveAction}" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
          <views:ActionButtonView Classes="settings-save-primary" ActionLabel="Save" Caption="Save" Icon="save" Primary="True"
              Command="{Binding CurrentSaveSource.Command}" Available="{Binding CurrentSaveSource.IsEnabled}" Height="48" MinHeight="48" MinWidth="140" HorizontalAlignment="Right" Tooltip="Save settings" />
        </Border>
    </Grid>
</UserControl>
