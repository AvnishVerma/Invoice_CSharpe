<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.AuthenticationFormView">
  <StackPanel Spacing="14.4">
    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
    <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" />
    <ContentControl x:Name="BodyHost" />
  </StackPanel>
</UserControl>
