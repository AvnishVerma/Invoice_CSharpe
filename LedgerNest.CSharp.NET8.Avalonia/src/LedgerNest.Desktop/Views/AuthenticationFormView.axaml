<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.AuthenticationFormView">
  <StackPanel Spacing="18">
    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
    <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#666666" TextWrapping="Wrap" />
    <ContentControl x:Name="BodyHost" />
  </StackPanel>
</UserControl>
