<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:LedgerNest.Desktop.Views"
             x:Class="LedgerNest.Desktop.Views.OnboardingStepView">
  <StackPanel Spacing="24">
    <views:BrandLogo HorizontalAlignment="Left" />
    <ContentControl x:Name="StepHost" />
    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
    <ContentControl x:Name="BodyHost" />
  </StackPanel>
</UserControl>
