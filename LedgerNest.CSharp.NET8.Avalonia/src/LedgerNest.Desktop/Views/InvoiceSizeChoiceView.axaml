<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.InvoiceSizeChoiceView" x:Name="Root">
  <UserControl.Styles><Style Selector="Border.field-caption"><Setter Property="Background" Value="{DynamicResource AppCardBrush}" /></Style></UserControl.Styles>
  <Grid Margin="0,8,0,0">
    <ComboBox x:Name="SizeSelector"
              HorizontalAlignment="Stretch"
              MinHeight="38.4"
              Padding="10,8"
              Background="{DynamicResource AppCardBrush}" />
    <Border Classes="field-caption" IsVisible="{Binding IsKeyboardFocusWithin, ElementName=Root}">
      <TextBlock x:Name="CaptionText" />
    </Border>
  </Grid>
</UserControl>
