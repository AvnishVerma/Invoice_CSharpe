<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LedgerNest.Desktop.Views.InvoiceCustomerPanelView">
  <Border Padding="13" CornerRadius="12" Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1">
    <StackPanel Spacing="8">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,12,*,12,*,12,Auto,6,Auto">
        <TextBlock Text="Bill to" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <ContentControl x:Name="CustomerNameHost" Grid.Column="2" />
        <ContentControl x:Name="CustomerPhoneHost" Grid.Column="4" />
        <ContentControl x:Name="SelectCustomerHost" Grid.Column="6" VerticalContentAlignment="Center" />
        <ContentControl x:Name="DetailsToggleHost" Grid.Column="8" VerticalContentAlignment="Center" />
        <ContentControl x:Name="CustomerDetailsHost" Grid.Row="1" Grid.ColumnSpan="9" Margin="0,8,0,0" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
