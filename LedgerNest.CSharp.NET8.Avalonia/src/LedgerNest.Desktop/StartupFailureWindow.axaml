<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LedgerNest.Desktop" xmlns:shared="using:LedgerNest.Desktop.Views"
        x:Class="LedgerNest.Desktop.StartupFailureWindow" x:DataType="local:StartupFailureViewModel"
        Width="640" Height="300" Title="LedgerNest">
  <Grid RowDefinitions="Auto,*,Auto">
    <shared:PageHeaderView Title="Open LedgerNest"/>
    <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="{DynamicResource PageContentPadding}" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="{DynamicResource PageContentPadding}">
      <Button Content="Close" Command="{Binding CloseCommand}" Classes="action"/>
      <Button Content="Retry" Command="{Binding RetryCommand}" Classes="action primary"/>
    </StackPanel>
  </Grid>
</Window>
