<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LedgerNest.Desktop"
             x:Class="LedgerNest.Desktop.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <x:Double x:Key="ExpanderMinHeight">36</x:Double>
      <x:Double x:Key="ExpanderChevronButtonSize">24</x:Double>
      <Thickness x:Key="ExpanderHeaderPadding">10,4</Thickness>
      <Thickness x:Key="ExpanderChevronMargin">6,0,0,0</Thickness>
      <x:Double x:Key="StandardControlHeight">32</x:Double>
      <x:Double x:Key="CompactActionHeight">28</x:Double>
      <x:Double x:Key="ActionButtonHeight">32</x:Double>
      <x:Double x:Key="ActionIconButtonSize">32</x:Double>
      <x:Double x:Key="ActionIconSize">18</x:Double>
      <x:Double x:Key="ApplicationSidebarWidth">210</x:Double>
      <x:Double x:Key="PageHeaderHeight">44.8</x:Double>
      <x:Double x:Key="SecondaryNavigationHeight">44</x:Double>
      <x:Double x:Key="SettingsLeftColumnWidth">280</x:Double>
      <x:Double x:Key="SettingsColumnGap">16</x:Double>
      <Thickness x:Key="PageHeaderPadding">20,0</Thickness>
      <Thickness x:Key="PageContentPadding">16</Thickness>
      <Thickness x:Key="PageContentPaddingCompact">12.8</Thickness>
      <Thickness x:Key="SecondaryNavigationPadding">6,4</Thickness>
      <CornerRadius x:Key="PageCardCornerRadius">12</CornerRadius>
      <Thickness x:Key="StandardControlPadding">10,5</Thickness>
      <Thickness x:Key="ActionButtonPadding">12,5</Thickness>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppCanvasBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppSurfaceBrush">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="AppCardBrush">#FBF5FF</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextBrush">#202124</SolidColorBrush>
          <SolidColorBrush x:Key="AppMutedBrush">#666666</SolidColorBrush>
          <SolidColorBrush x:Key="AppOutlineBrush">#D0D0D0</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBrush">#083B88</SolidColorBrush>
          <SolidColorBrush x:Key="AppSelectedBrush">#E8EEF7</SolidColorBrush>
          <SolidColorBrush x:Key="AppHoverBrush">#EEF2F7</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppCanvasBrush">#111820</SolidColorBrush>
          <SolidColorBrush x:Key="AppSurfaceBrush">#18212B</SolidColorBrush>
          <SolidColorBrush x:Key="AppCardBrush">#202B36</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextBrush">#F1F5F9</SolidColorBrush>
          <SolidColorBrush x:Key="AppMutedBrush">#BBC5D0</SolidColorBrush>
          <SolidColorBrush x:Key="AppOutlineBrush">#526171</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBrush">#93C5FD</SolidColorBrush>
          <SolidColorBrush x:Key="AppSelectedBrush">#293F59</SolidColorBrush>
          <SolidColorBrush x:Key="AppHoverBrush">#263646</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    <SolidColorBrush x:Key="PageHeaderBrush" Color="{x:Static local:Branding.HeaderColor}" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="ToggleButton.form-toggle /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://LedgerNest.Desktop/Assets#Roboto" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="{DynamicResource StandardControlPadding}" />
      <Setter Property="MinHeight" Value="{DynamicResource StandardControlHeight}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.compact-action">
      <Setter Property="MinHeight" Value="{DynamicResource CompactActionHeight}" />
      <Setter Property="MinWidth" Value="{DynamicResource CompactActionHeight}" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="{DynamicResource ActionButtonHeight}" />
      <Setter Property="MinHeight" Value="{DynamicResource ActionButtonHeight}" />
      <Setter Property="Padding" Value="{DynamicResource ActionButtonPadding}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action-icon">
      <Setter Property="Width" Value="{DynamicResource ActionIconButtonSize}" />
      <Setter Property="Height" Value="{DynamicResource ActionIconButtonSize}" />
      <Setter Property="MinWidth" Value="{DynamicResource ActionIconButtonSize}" />
      <Setter Property="MinHeight" Value="{DynamicResource ActionIconButtonSize}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.action-icon-glyph">
      <Setter Property="FontFamily" Value="avares://LedgerNest.Desktop/Assets#Material Icons" />
      <Setter Property="FontSize" Value="{DynamicResource ActionIconSize}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.exportButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="Button.pageButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="MinHeight" Value="{DynamicResource CompactActionHeight}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.dialog-action">
      <Setter Property="MinHeight" Value="{DynamicResource StandardControlHeight}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="MinHeight" Value="38.4" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox">
      <Setter Property="MinHeight" Value="{DynamicResource StandardControlHeight}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="DatePicker">
      <Setter Property="MinHeight" Value="{DynamicResource StandardControlHeight}" />
    </Style>
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#083B88" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1555A6" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.header-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#AFFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="{DynamicResource ActionButtonHeight}" />
      <Setter Property="Padding" Value="{DynamicResource ActionButtonPadding}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.header-icon-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#AFFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Width" Value="{DynamicResource ActionIconButtonSize}" />
      <Setter Property="Height" Value="{DynamicResource ActionIconButtonSize}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.header-icon-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.page-header-title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.page-header">
      <Setter Property="Height" Value="{DynamicResource PageHeaderHeight}" />
      <Setter Property="Padding" Value="{DynamicResource PageHeaderPadding}" />
      <Setter Property="Background" Value="{DynamicResource PageHeaderBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.secondary-navigation">
      <Setter Property="MinHeight" Value="{DynamicResource SecondaryNavigationHeight}" />
      <Setter Property="Padding" Value="{DynamicResource SecondaryNavigationPadding}" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.page-content">
      <Setter Property="Padding" Value="{DynamicResource PageContentPadding}" />
      <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
    </Style>
    <Style Selector="Border.page-card">
      <Setter Property="CornerRadius" Value="{DynamicResource PageCardCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.settings-column">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="{DynamicResource PageCardCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.settings-section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.header-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#062C66" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.material">
      <Setter Property="Background" Value="#083B88" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.text">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="33.6" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="PlaceholderForeground" Value="{DynamicResource AppMutedBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="{DynamicResource StandardControlHeight}" />
      <Setter Property="Padding" Value="{DynamicResource StandardControlPadding}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppOutlineBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="{DynamicResource StandardControlHeight}" />
      <Setter Property="Padding" Value="{DynamicResource StandardControlPadding}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="{DynamicResource StandardControlHeight}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="MinHeight" Value="{DynamicResource StandardControlHeight}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
