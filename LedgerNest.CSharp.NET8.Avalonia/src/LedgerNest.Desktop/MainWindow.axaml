<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LedgerNest.Desktop"
        xmlns:views="using:LedgerNest.Desktop.Views"
        x:Class="LedgerNest.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440" Height="900" MinWidth="640" MinHeight="480"
        Title="LadgerNest" Background="{DynamicResource AppCanvasBrush}">
  <Grid x:Name="Root">
    <Grid>
      <Grid x:Name="Body" ColumnDefinitions="Auto,*">
        <ContentControl x:Name="sidebar" />
        <ContentControl x:Name="page" Grid.Column="1" />
      </Grid>
    </Grid>
    <Grid x:Name="overlay" IsVisible="{Binding IsOverlayOpen}" ColumnDefinitions="Auto,*">
      <Border Width="{Binding #sidebar.Bounds.Width}" IsVisible="{Binding IsSideOverlay}" IsHitTestVisible="False" />
      <ContentControl Grid.Column="1" Content="{Binding CurrentOverlay}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
          <DataTemplate DataType="vm:ProductItemDialogViewModel"><views:ProductItemDialogView /></DataTemplate>
          <DataTemplate DataType="vm:OverlayDialogViewModel"><views:OverlayDialogView /></DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>
    <Border x:Name="toastCard"
            IsVisible="False"
            Width="390"
            MaxWidth="{Binding #Root.Bounds.Width}"
            Margin="20"
            Padding="14"
            CornerRadius="12"
            BorderThickness="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            ZIndex="100">
      <Grid ColumnDefinitions="40,*,Auto">
        <Border x:Name="toastIconCircle" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top">
          <TextBlock x:Name="toastIcon" FontFamily="avares://LedgerNest.Desktop/Assets#Material Icons" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0" Spacing="3">
          <TextBlock x:Name="toastTitle" FontSize="14" FontWeight="SemiBold" />
          <TextBlock x:Name="toastMessage" FontSize="12.5" TextWrapping="Wrap" MaxWidth="285" />
        </StackPanel>
        <Button Grid.Column="2" Content="×" Classes="text" Padding="5" MinWidth="28" MinHeight="28" VerticalAlignment="Top" Click="OnDismissToast" />
      </Grid>
    </Border>
  </Grid>
</Window>
