<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Invoiso.Desktop.MainWindow"
        Width="1200" Height="760"
        Title="Invoiso">
  <Grid ColumnDefinitions="240,*">
    <Border Grid.Column="0" Padding="20">
      <StackPanel Spacing="10">
        <TextBlock Text="INVOISO" FontSize="26" FontWeight="Bold"/>
        <Button Content="Dashboard"/>
        <Button Content="Invoices"/>
        <Button Content="Quotations"/>
        <Button Content="Customers"/>
        <Button Content="Products"/>
        <Button Content="Payments"/>
        <Button Content="Reports"/>
        <Button Content="Settings"/>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="25">
      <StackPanel Spacing="5">
        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold"/>
        <TextBlock Text="Desktop invoicing and business management"/>
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,30,0,0">
        <Border Grid.Column="0" Margin="5" Padding="20">
          <StackPanel>
            <TextBlock Text="Sales"/>
            <TextBlock Text="₹ 0.00" FontSize="24" FontWeight="Bold"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="5" Padding="20">
          <StackPanel>
            <TextBlock Text="Receivables"/>
            <TextBlock Text="₹ 0.00" FontSize="24" FontWeight="Bold"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Margin="5" Padding="20">
          <StackPanel>
            <TextBlock Text="Invoices"/>
            <TextBlock Text="0" FontSize="24" FontWeight="Bold"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
